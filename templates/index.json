        "item_1": {
          "type": "item",
          "settings": {
            "question": "Hvornår er Black Week?",
            "answer": "<p>Presale for tilmeldte fredag 20.11 kl. 12:00. Åbent for alle søndag 22.11 kl. 20:00. Black Week slutter mandag 30.11 kl. 23:59 (Cyber Monday).</p>"
