{
  "sections": {
    "custom_liquid_BQWVna": {
      "type": "custom-liquid",
      "name": "Custom Liquid",
      "settings": {
        "full_width": true,
        "remove_vertical_spacing": true,
        "remove_horizontal_spacing": true,
        "liquid": "<style>\n  .arox-banner-wrapper {\n    background-color: #000000;\n    color: #ffffff;\n    padding: 12px 16px;\n    font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\n    border-bottom: 2px solid #E31B23;\n    width: 100%;\n    box-sizing: border-box;\n  }\n\n  .arox-banner-container {\n    max-width: 1200px;\n    margin: 0 auto;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 16px;\n  }\n\n  .arox-banner-content {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n  }\n\n  .arox-badge {\n    background-color: #E31B23;\n    color: #ffffff;\n    font-size: 11px;\n    font-weight: 900;\n    padding: 4px 8px;\n    border-radius: 3px;\n    letter-spacing: 1px;\n    text-transform: uppercase;\n    white-space: nowrap;\n  }\n\n  .arox-title {\n    font-size: 14px;\n    font-weight: 800;\n    letter-spacing: 0.5px;\n    text-transform: uppercase;\n    margin: 0;\n    color: #ffffff;\n  }\n\n  /* Countdown timere */\n  .arox-timer {\n    display: flex;\n    align-items: center;\n    gap: 6px;\n  }\n\n  .arox-timer-unit {\n    background: rgba(255, 255, 255, 0.08);\n    border: 1px solid rgba(255, 255, 255, 0.15);\n    border-radius: 6px;\n    padding: 4px 8px;\n    min-width: 46px;\n    text-align: center;\n  }\n\n  .arox-timer-val {\n    font-size: 16px;\n    font-weight: 900;\n    line-height: 1;\n    color: #ffffff;\n    font-variant-numeric: tabular-nums;\n  }\n\n  .arox-timer-lbl {\n    font-size: 8px;\n    font-weight: 700;\n    color: #a0a0a0;\n    text-transform: uppercase;\n    margin-top: 2px;\n    letter-spacing: 0.5px;\n  }\n\n  .arox-timer-divider {\n    font-size: 14px;\n    font-weight: 800;\n    color: rgba(255, 255, 255, 0.4);\n  }\n\n  /* CTA Knap */\n  .arox-btn {\n    background-color: #E31B23;\n    color: #ffffff;\n    text-decoration: none;\n    font-size: 12px;\n    font-weight: 800;\n    padding: 8px 18px;\n    border-radius: 4px;\n    letter-spacing: 1px;\n    text-transform: uppercase;\n    transition: transform 0.15s ease, background-color 0.15s ease;\n    white-space: nowrap;\n    display: inline-block;\n  }\n\n  .arox-btn:hover {\n    background-color: #ff2a33;\n    transform: translateY(-1px);\n  }\n\n  /* Mobiloptimering */\n  @media (max-width: 768px) {\n    .arox-banner-container {\n      flex-direction: column;\n      justify-content: center;\n      text-align: center;\n      gap: 10px;\n    }\n\n    .arox-banner-content {\n      justify-content: center;\n      flex-wrap: wrap;\n      gap: 6px;\n    }\n\n    .arox-title {\n      font-size: 12px;\n    }\n\n    .arox-timer-unit {\n      min-width: 40px;\n      padding: 3px 6px;\n    }\n\n    .arox-timer-val {\n      font-size: 14px;\n    }\n\n    .arox-btn {\n      width: 100%;\n      text-align: center;\n      box-sizing: border-box;\n      padding: 10px 12px;\n      font-size: 11px;\n    }\n  }\n</style>\n\n<div class=\"arox-banner-wrapper\" id=\"arox-birthday-banner\">\n  <div class=\"arox-banner-container\">\n    \n    <div class=\"arox-banner-content\">\n      <span class=\"arox-badge\">5 ÅR</span>\n      <h3 class=\"arox-title\">FEJR 5 ÅR MED AROX – EKSKLUSIVE TILBUD</h3>\n    </div>\n\n    <div class=\"arox-timer\">\n      <div class=\"arox-timer-unit\">\n        <div class=\"arox-timer-val\" id=\"arox-d\">00</div>\n        <div class=\"arox-timer-lbl\">DAGE</div>\n      </div>\n      <span class=\"arox-timer-divider\">:</span>\n      <div class=\"arox-timer-unit\">\n        <div class=\"arox-timer-val\" id=\"arox-h\">00</div>\n        <div class=\"arox-timer-lbl\">TIMER</div>\n      </div>\n      <span class=\"arox-timer-divider\">:</span>\n      <div class=\"arox-timer-unit\">\n        <div class=\"arox-timer-val\" id=\"arox-m\">00</div>\n        <div class=\"arox-timer-lbl\">MIN</div>\n      </div>\n      <span class=\"arox-timer-divider\">:</span>\n      <div class=\"arox-timer-unit\">\n        <div class=\"arox-timer-val\" id=\"arox-s\">00</div>\n        <div class=\"arox-timer-lbl\">SEK</div>\n      </div>\n    </div>\n\n    <!-- Ret href til din specifikke tilbudsside -->\n    <a href=\"https://aroxfitness.dk/collections/5-ar-med-arox\" class=\"arox-btn\">SE FØDSELSDAGSTILBUD</a>\n\n  </div>\n</div>\n\n<script>\n  (function() {\n    const currentYear = new Date().getFullYear();\n    const targetDate = new Date(`${currentYear}-09-14T23:59:59`).getTime();\n\n    function updateCounter() {\n      const now = new Date().getTime();\n      const diff = targetDate - now;\n\n      if (diff <= 0) {\n        const banner = document.getElementById('arox-birthday-banner');\n        if (banner) banner.style.display = 'none';\n        return;\n      }\n\n      const days = Math.floor(diff / (1000 * 60 * 60 * 24));\n      const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));\n      const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));\n      const seconds = Math.floor((diff % (1000 * 60)) / 1000);\n\n      document.getElementById('arox-d').innerText = String(days).padStart(2, '0');\n      document.getElementById('arox-h').innerText = String(hours).padStart(2, '0');\n      document.getElementById('arox-m').innerText = String(minutes).padStart(2, '0');\n      document.getElementById('arox-s').innerText = String(seconds).padStart(2, '0');\n    }\n\n    updateCounter();\n    setInterval(updateCounter, 1000);\n  })();\n</script>",
        "background": "",
        "background_gradient": "",
        "text_color": ""
      }
    },
