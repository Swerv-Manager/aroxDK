        "liquid_BEj3hB": {
          "type": "liquid",
          "settings": {
            "liquid": "{% assign variants_collection = nil %}\n\n{% for collection in product.collections %}\n    {% if collection.handle contains 'Colour' or collection.title contains 'Colour' %}\n        {% assign variants_collection = collection %}\n        {% break %}\n    {% endif %}\n{% endfor %}\n\n{% if variants_collection != blank %}\n    <div class=\"product-single__colors\">\n        <h4 class=\"VariantHeading Heading u-h6\">Andra färger:\n <span style=\"color:black\">{% assign parts = product.title | split: \" - \" %}\n{% if parts.size > 1 %}\n  {{ parts | last }}\n{% else %}\n  {{ product.title }}\n{% endif %}\n<span> </h4>\n        <div class=\"colors__row\">\n            {% assign counter = 0 %}\n            {% for variants_product in variants_collection.products %}\n                {% if counter < 7 %}\n                    <a href=\"{{ variants_product.url }}\" class=\"colors__item {% if product.handle == variants_product.handle %}active{% endif %}\" title=\"{{ variants_product.title }}\">\n                        <img src=\"{{ variants_product.images[0] | img_url: 'x' }}\" class=\"product-image {% if product.handle == variants_product.handle %}current-product{% endif %}\" alt=\"{{ variants_product.title }}\" />\n                    </a>\n                    {% assign counter = counter | plus: 1 %}\n                {% endif %}\n            {% endfor %}\n        </div>\n    </div>\n{% endif %}\n\n<style>\n.colors__row {\n    text-align: initial;\n    display: flex;\n    flex-wrap: wrap;\n    gap: 15px; \n    margin-bottom: 20px;\n}\n\n.product-single__colors h4 {\n    margin-bottom: 10px; /* Reduced to make the gap smaller between text and images */\n}\n\n.product-image {\n    width: 90%;\n}\n\n.product-image.current-product {\n    border: 2px solid #000;\n    width: calc(93% - 4px);\n}\n</style>"
          }
        },
