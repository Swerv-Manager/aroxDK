{%- comment -%}BLACK WEEK 2026 · Kampagne-topbar: slank nedtælling under headeren (02–08 m.fl.){%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign hide_list = s.hide_on | replace: ' ', '' | split: ','
  assign hidden = false
  if hide_list contains template.name
    assign hidden = true
  endif
-%}
{%- unless hidden -%}
<div class="bw{% render 'bw-only', phases: s.phases %}" style="container-type:inline-size">
  <div style="background:#0a0a0a;color:#fff;border-bottom:1px solid #222;padding:12px max(clamp(20px,calc((100cqw - 767px)*1000),64px),calc((100cqw - 1312px)/2))">{% render 'bw-countdown', compact: true %}</div>
</div>
{%- endunless -%}

{% schema %}
{
  "name": "BW · Kampagne-topbar",
  "tag": "aside",
  "class": "bw-section",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "text", "id": "phases", "label": "Vis kun i faser", "info": "pre, early, live, sidste · tom = altid" },
    { "type": "text", "id": "hide_on", "label": "Skjul på sidetyper", "default": "cart, login, account, password", "info": "Kommasepareret liste af template-navne, fx cart, page, search" },
    { "type": "paragraph", "content": "Tekst og sluttidspunkt følger fasen automatisk (presale → tidlig adgang → live)." }
  ],
  "presets": [ { "name": "BW · Kampagne-topbar" } ]
}
{% endschema %}
