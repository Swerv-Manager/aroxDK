{%- comment -%}
BLACK WEEK 2026 · Presale / tilmelding (board 02 #presale), ported 1:1 from the design.
Shown in presale, tidlig adgang and sidste dag (hidden in live, as in the design). Texts differ in presale.
Signup: Shopify customer form (newsletter consent) tagged with the "Tags" setting (+ "sms" when the SMS box is ticked).
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign G = 'max(clamp(20px,calc((100cqw - 767px)*1000),64px),calc((100cqw - 1312px)/2))'
  assign PY = 'clamp(48px,calc((100cqw - 767px)*1000),80px)'
  assign inp = 'height:52px;border-radius:4px;border:1px solid #e4e4e4;background:#fff;color:#111;padding:0 16px;font:inherit;font-size:16px;width:100%;box-sizing:border-box;margin:0'
  assign lab = 'display:flex;gap:12px;align-items:center;min-height:44px;font-size:14px;line-height:1.4;color:#fff'
-%}
<style>
  #shopify-section-{{ section.id }} input::placeholder { color: #6e6e6e; }
  #shopify-section-{{ section.id }} a:hover { opacity: 1; }
  #shopify-section-{{ section.id }} button[type=submit]:hover { background: #e4e4e4 !important; }
</style>
<div class="bw{% render 'bw-only', phases: s.phases %}" style="container-type:inline-size">
  <div id="presale" style="position:relative;background:#0a0a0a;color:#fff;overflow:hidden">
    {%- if s.image != blank -%}{{ s.image | image_url: width: 2400 | image_tag: loading: 'lazy', sizes: '100vw', widths: '750,1100,1500,2000,2400', alt: '', style: 'position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:35% 40%' }}{%- endif -%}
    <div style="position:absolute;inset:0;background:rgba(10,10,10,.72)"></div>
    <div style="position:relative;padding:{{ PY }} {{ G }};display:grid;grid-template-columns:repeat(auto-fit,minmax(max(300px,calc((100% - 64px)/2)),1fr));gap:32px 64px;align-items:center">
      <div style="display:grid;gap:16px">
        <div class="{% render 'bw-only', phases: 'pre' %}" style="font-size:12px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:#e4e4e4">{{ s.eyebrow_pre }}</div>
        <div class="{% render 'bw-only', phases: 'early live sidste ended' %}" style="font-size:12px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:#e4e4e4">{{ s.eyebrow }}</div>
        <h2 class="{% render 'bw-only', phases: 'pre' %}" style="margin:0;font-size:clamp(34px,4.6cqw,68px);font-weight:900;text-transform:uppercase;letter-spacing:-.01em;line-height:1;font-family:inherit;color:#fff">{{ s.heading_1_pre }}<br>{{ s.heading_2_pre }}</h2>
        <h2 class="{% render 'bw-only', phases: 'early live sidste ended' %}" style="margin:0;font-size:clamp(34px,4.6cqw,68px);font-weight:900;text-transform:uppercase;letter-spacing:-.01em;line-height:1;font-family:inherit;color:#fff">{{ s.heading_1 }}<br>{{ s.heading_2 }}</h2>
        <div class="{% render 'bw-only', phases: 'pre' %}" style="font-size:clamp(15px,1.25cqw,18px);line-height:1.5;color:#e4e4e4;max-width:480px">{{ s.text_pre }}</div>
        <div class="{% render 'bw-only', phases: 'early live sidste ended' %}" style="font-size:clamp(15px,1.25cqw,18px);line-height:1.5;color:#e4e4e4;max-width:480px">{{ s.text }}</div>
      </div>
      {%- form 'customer', id: 'bw-presale-form', style: 'margin:0 !important;padding:0 !important;border:0;background:none;box-shadow:none;max-width:none' -%}
        {%- if form.posted_successfully? -%}
          <div style="display:grid;gap:12px;max-width:520px;padding:28px;border:1px solid #e4e4e4;border-radius:12px">
            <div style="font-size:28px;font-weight:900;text-transform:uppercase;line-height:1">{{ s.ok_heading_1 }}<br>{{ s.ok_heading_2 }}</div>
            <div class="{% render 'bw-only', phases: 'pre' %}" style="font-size:15px;line-height:1.5;color:#e4e4e4">{{ s.ok_text_pre }}</div>
            <div class="{% render 'bw-only', phases: 'early live sidste ended' %}" style="font-size:15px;line-height:1.5;color:#e4e4e4">{{ s.ok_text }}</div>
            <a href="{{ request.path }}#presale" style="justify-self:start;color:#fff;font-size:14px;font-weight:700;text-decoration:underline;text-underline-offset:4px">{{ s.again_label }}</a>
          </div>
        {%- else -%}
          <div style="display:grid;gap:12px;max-width:520px">
            {%- if form.errors -%}<div style="font-size:14px;color:#ffb4b4">{{ form.errors | default_errors }}</div>{%- endif -%}
            <input type="hidden" name="contact[tags]" value="{{ s.tags | escape }}" data-bw-tags>
            <input type="text" name="contact[first_name]" placeholder="{{ s.ph_name | escape }}" autocomplete="given-name" aria-label="{{ s.ph_name | escape }}" style="{{ inp }}">
            <input type="email" name="contact[email]" placeholder="{{ s.ph_email | escape }}" autocomplete="email" required aria-label="{{ s.ph_email | escape }}" style="{{ inp }}">
            <input type="tel" name="contact[phone]" placeholder="{{ s.ph_phone | escape }}" autocomplete="tel" aria-label="{{ s.ph_phone | escape }}" style="{{ inp }}">
            <label style="{{ lab }}"><input type="checkbox" name="contact[accepts_marketing]" value="true" required style="width:20px;height:20px;accent-color:#fff;flex:none;margin:0"><span>{{ s.consent_email }}</span></label>
            <label style="{{ lab }}"><input type="checkbox" data-bw-sms style="width:20px;height:20px;accent-color:#fff;flex:none;margin:0"><span>{{ s.consent_sms }}</span></label>
            <button type="submit" style="height:52px;border-radius:999px;border:0;background:#fff;color:#111;font:inherit;font-size:15px;font-weight:700;cursor:pointer;display:flex;align-items:center;justify-content:center;text-align:center;width:100%;padding:0 28px;letter-spacing:normal;text-transform:none"><span class="{% render 'bw-only', phases: 'pre' %}">{{ s.button_pre }}</span><span class="{% render 'bw-only', phases: 'early live sidste ended' %}">{{ s.button }}</span></button>
            <div style="font-size:12px;line-height:1.5;color:#e4e4e4">{{ s.legal }}</div>
          </div>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</div>
<script>
  (function () {
    var f = document.getElementById('bw-presale-form');
    if (!f) return;
    f.addEventListener('submit', function () {
      var sms = f.querySelector('[data-bw-sms]'), tags = f.querySelector('[data-bw-tags]');
      if (sms && tags && sms.checked && tags.value.indexOf('sms') === -1) tags.value += ',sms';
    });
  })();
</script>

{% schema %}
{
  "name": "BW · Presale-tilmelding",
  "tag": "section",
  "class": "bw-section",
  "settings": [
    { "type": "text", "id": "phases", "label": "Vis kun i faser", "info": "pre, early, live, sidste · tom = altid", "default": "pre, early, sidste" },
    { "type": "image_picker", "id": "image", "label": "Baggrundsbillede" },
    { "type": "text", "id": "tags", "label": "Kundetags", "default": "newsletter,bw26-presale" },
    { "type": "header", "content": "Presale" },
    { "type": "text", "id": "eyebrow_pre", "label": "Overlinje", "default": "Presale" },
    { "type": "text", "id": "heading_1_pre", "label": "Overskrift linje 1", "default": "TILMELD DIG." },
    { "type": "text", "id": "heading_2_pre", "label": "Overskrift linje 2", "default": "SHOP FØR ALLE ANDRE." },
    { "type": "textarea", "id": "text_pre", "label": "Tekst", "default": "Få adgang til Black Week fredag 20.11 kl. 12:00 – før vi åbner for alle søndag 22.11 kl. 20:00." },
    { "type": "text", "id": "button_pre", "label": "Knap", "default": "Tilmeld dig presale" },
    { "type": "text", "id": "ok_text_pre", "label": "Tak-tekst", "default": "Vi giver dig besked, når presale åbner fredag 20.11 kl. 12:00." },
    { "type": "header", "content": "Efter presale" },
    { "type": "text", "id": "eyebrow", "label": "Overlinje", "default": "SMS + mail" },
    { "type": "text", "id": "heading_1", "label": "Overskrift linje 1", "default": "TILMELD DIG." },
    { "type": "text", "id": "heading_2", "label": "Overskrift linje 2", "default": "HØR DET FØRST." },
    { "type": "textarea", "id": "text", "label": "Tekst", "default": "Få besked på SMS og mail, når vi har tilbud." },
    { "type": "text", "id": "button", "label": "Knap", "default": "Tilmeld dig" },
    { "type": "text", "id": "ok_text", "label": "Tak-tekst", "default": "Vi giver dig besked, næste gang der sker noget." },
    { "type": "header", "content": "Formular" },
    { "type": "text", "id": "ph_name", "label": "Felt: navn", "default": "Fornavn" },
    { "type": "text", "id": "ph_email", "label": "Felt: e-mail", "default": "E-mail" },
    { "type": "text", "id": "ph_phone", "label": "Felt: telefon", "default": "Telefonnummer (valgfrit – til SMS)" },
    { "type": "text", "id": "consent_email", "label": "Samtykke e-mail", "default": "Ja tak til nyheder og tilbud på e-mail" },
    { "type": "text", "id": "consent_sms", "label": "Samtykke SMS", "default": "Ja tak til nyheder og tilbud på SMS" },
    { "type": "text", "id": "legal", "label": "Småt", "default": "Du kan altid afmelde dig igen. Læs mere i vores privatlivspolitik." },
    { "type": "text", "id": "ok_heading_1", "label": "Tak linje 1", "default": "Tak." },
    { "type": "text", "id": "ok_heading_2", "label": "Tak linje 2", "default": "Du er på listen." },
    { "type": "text", "id": "again_label", "label": "Tilmeld en til", "default": "Tilmeld en til" }
  ],
  "presets": [ { "name": "BW · Presale-tilmelding" } ]
}
{% endschema %}
