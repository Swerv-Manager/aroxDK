{%- comment -%}BLACK WEEK 2026 · Kampagnevilkår key/value list (board 11).{%- endcomment -%}
<style>
  .bw-terms__list { display: grid; border-top: 1px solid #fff; max-width: 980px; }
  .bw-terms__row { display: grid; grid-template-columns: minmax(110px, 1fr) minmax(0, 2.4fr); gap: 4px 24px; padding: 14px 0; border-bottom: 1px solid #2b2b2b; }
  .bw-terms__k { font-size: 14px; font-weight: 800; }
  .bw-terms__v { font-size: 15px; line-height: 1.5; }
</style>
<div class="bw bw-terms{% render 'bw-only', phases: section.settings.phases %}">
  <div class="bw-sec">
    {%- if section.settings.heading != blank -%}
      <h2 class="bw-h2" style="margin:0 0 8px;font-size:clamp(24px,2.6vw,36px);letter-spacing:-.005em">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <div class="bw-terms__list">
      {%- for block in section.blocks -%}
        <div class="bw-terms__row" {{ block.shopify_attributes }}>
          <div class="bw-terms__k">{{ block.settings.key }}</div>
          <div class="bw-terms__v">{{ block.settings.value }}</div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "BW · Kampagnevilkår",
  "class": "bw-section",
  "settings": [
    { "type": "text", "id": "phases", "label": "Vis kun i faser", "info": "pre, early, live, sidste · tom = altid" },
    { "type": "text", "id": "heading", "label": "Overskrift", "default": "Kampagnevilkår" }
  ],
  "blocks": [
    {
      "type": "term",
      "name": "Vilkår",
      "settings": [
        { "type": "text", "id": "key", "label": "Emne", "default": "Kampagneperiode" },
        { "type": "textarea", "id": "value", "label": "Tekst", "default": "Black Week 20.11–30.11.2026." }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [{ "name": "BW · Kampagnevilkår", "blocks": [{ "type": "term" }] }]
}
{% endschema %}
