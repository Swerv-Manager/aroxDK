{%- comment -%}BLACK WEEK 2026 · Gaveside hero (board 09): text + buttons left, white gift cards right.{%- endcomment -%}
<style>
  .bw-gh__cards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .bw-gh__card { background: #fff; color: #111; border-radius: 12px; padding: 12px; display: grid; gap: 12px; align-content: start; }
  .bw-gh__img { aspect-ratio: 1 / 1; border-radius: 8px; overflow: hidden; background: #f8f8f8; }
  .bw-gh__img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .bw-gh__t { font-size: 13px; font-weight: 800; letter-spacing: .04em; text-transform: uppercase; padding: 0 4px 4px; }
  .bw-gh .bw-h1 { font-size: clamp(42px, 6.6vw, 100px); letter-spacing: -.015em; line-height: .95; }
</style>
<div class="bw bw-gh{% render 'bw-only', phases: section.settings.phases %}">
  <div class="bw-sec">
    <div class="bw-grid-2" style="gap:32px 64px">
      <div style="display:grid;gap:18px">
        {%- if section.settings.eyebrow != blank -%}<div class="bw-eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
        <h1 class="bw-h1">{{ section.settings.heading_1 }}{% if section.settings.heading_2 != blank %}<br>{{ section.settings.heading_2 }}{% endif %}</h1>
        {%- if section.settings.text != blank -%}<div class="bw-lead">{{ section.settings.text }}</div>{%- endif -%}
        <div style="display:flex;gap:10px;flex-wrap:wrap">
          {%- if section.settings.btn1_label != blank -%}<a href="{{ section.settings.btn1_url | default: '#' }}" class="bw-btn">{{ section.settings.btn1_label }}</a>{%- endif -%}
          {%- if section.settings.btn2_label != blank -%}<a href="{{ section.settings.btn2_url | default: '#' }}" class="bw-btn bw-btn--outline">{{ section.settings.btn2_label }}</a>{%- endif -%}
        </div>
      </div>
      <div class="bw-gh__cards">
        {%- for block in section.blocks -%}
          <div class="bw-gh__card" {{ block.shopify_attributes }}>
            <div class="bw-gh__img">
              {%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: block.settings.title, sizes: '(min-width: 768px) 25vw, 50vw', widths: '300,400,600,800' }}{%- endif -%}
            </div>
            <div class="bw-gh__t">{{ block.settings.title }}</div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "BW · Gave-hero",
  "settings": [
    { "type": "text", "id": "phases", "label": "Vis kun i faser", "info": "pre, early, live, sidste · tom = altid" },
    { "type": "text", "id": "eyebrow", "label": "Overlinje", "default": "Gave i Black Week" },
    { "type": "text", "id": "heading_1", "label": "Overskrift linje 1", "default": "Gave med hjem." },
    { "type": "text", "id": "heading_2", "label": "Overskrift linje 2", "default": "Oveni." },
    { "type": "textarea", "id": "text", "label": "Tekst", "default": "Er din ordre blandt de første 100 i Black Week, får du en gratis Thermo stålflaske med. Uanset beløb." },
    { "type": "text", "id": "btn1_label", "label": "Knap 1", "default": "Se single offers" },
    { "type": "url", "id": "btn1_url", "label": "Knap 1 link" },
    { "type": "text", "id": "btn2_label", "label": "Knap 2 (outline)", "default": "Shop 3 for 2" },
    { "type": "url", "id": "btn2_url", "label": "Knap 2 link" }
  ],
  "blocks": [
    {
      "type": "gift",
      "name": "Gave",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Billede" },
        { "type": "text", "id": "title", "label": "Navn", "default": "Thermo stålflaske 1,06 L" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "BW · Gave-hero", "blocks": [{ "type": "gift" }] }]
}
{% endschema %}
