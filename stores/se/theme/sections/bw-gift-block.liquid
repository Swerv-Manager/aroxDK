{%- comment -%}
BLACK WEEK 2026 · "Gave med hjem. Oveni.", ported 1:1 from the design.
Layout "card" (02 Forside #gaver): white product card for the gift + note + outline button.
Layout "rules" (03 Landingsside): rule tiles 01/02 (blocks) + bottle thumbnail + outline button.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign G = 'max(clamp(20px,calc((100cqw - 767px)*1000),64px),calc((100cqw - 1312px)/2))'
  assign PY = 'clamp(48px,calc((100cqw - 767px)*1000),80px)'
-%}
<style>#shopify-section-{{ section.id }} a:hover { opacity: 1; }</style>
<div class="bw{% render 'bw-only', phases: s.phases %}" style="container-type:inline-size">
  <div id="gaver" style="background:#0a0a0a;color:#fff;padding:{{ PY }} {{ G }};display:grid;gap:24px">
    <div style="margin-bottom:8px;display:grid;gap:12px">
      <div style="font-size:12px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:#9b9b9b">{{ s.eyebrow }}</div>
      <h2 style="margin:0;font-size:clamp(34px,4.6cqw,68px);font-weight:900;text-transform:uppercase;letter-spacing:-.01em;line-height:1;font-family:inherit;color:#fff">{{ s.heading_1 }}<br>{{ s.heading_2 }}</h2>
    </div>
    {%- if s.layout == 'rules' -%}
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(max(240px,calc((100% - 32px)/3)),1fr));gap:16px">
        {%- for block in section.blocks -%}
          <div {{ block.shopify_attributes }} style="background:#111;border:1px solid #222;border-radius:12px;padding:24px;display:grid;gap:10px;align-content:start"><div style="font-size:clamp(36px,3.4cqw,52px);font-weight:900;line-height:1">{{ block.settings.number }}</div><div style="font-size:13px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:#9b9b9b">{{ block.settings.kicker }}</div><div style="font-size:20px;font-weight:900;text-transform:uppercase;line-height:1.1">{{ block.settings.title }}</div><div style="font-size:15px;line-height:1.5;color:#e4e4e4">{{ block.settings.text }}</div></div>
        {%- endfor -%}
      </div>
      <div style="display:flex;gap:16px 24px;align-items:center;flex-wrap:wrap;justify-content:space-between">
        <div style="display:flex;gap:10px"><div style="width:clamp(72px,7cqw,96px);aspect-ratio:1/1;border-radius:8px;overflow:hidden;background:#f8f8f8;flex:none">{%- if s.image != blank -%}{{ s.image | image_url: width: 300 | image_tag: loading: 'lazy', alt: s.card_title, style: 'width:100%;height:100%;object-fit:cover;display:block' }}{%- endif -%}</div></div>
        {%- if s.button_label != blank -%}<a href="{{ s.button_url | default: '#' }}" style="display:inline-flex;align-items:center;justify-content:center;height:48px;padding:0 28px;border-radius:999px;font-size:15px;font-weight:700;text-decoration:none;border:1.5px solid #fff;color:#fff">{{ s.button_label }}</a>{%- endif -%}
      </div>
    {%- else -%}
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(max(300px,calc((100% - 16px)/2)),1fr));gap:16px">
        <div style="background:#fff;color:#111;border-radius:12px;padding:16px;display:grid;grid-template-columns:clamp(112px,12cqw,180px) 1fr;gap:20px;align-items:center">
          <div style="aspect-ratio:1/1;border-radius:8px;overflow:hidden;background:#f8f8f8">{%- if s.image != blank -%}{{ s.image | image_url: width: 400 | image_tag: loading: 'lazy', alt: s.card_title, style: 'width:100%;height:100%;object-fit:cover;display:block' }}{%- endif -%}</div>
          <div style="display:grid;gap:8px"><div style="font-size:18px;font-weight:900;text-transform:uppercase">{{ s.card_title }}</div><div style="font-size:15px;line-height:1.5;color:#3a3a3a">{{ s.card_text }}</div></div>
        </div>
      </div>
      <div style="display:flex;gap:16px 32px;align-items:center;flex-wrap:wrap;justify-content:space-between">
        {%- if s.note != blank -%}<div style="font-size:15px;line-height:1.5;color:#e4e4e4">{{ s.note }}</div>{%- endif -%}
        {%- if s.button_label != blank -%}<a href="{{ s.button_url | default: '#' }}" style="display:inline-flex;align-items:center;height:48px;padding:0 28px;border-radius:999px;border:1.5px solid #fff;color:#fff;font-size:15px;font-weight:700;text-decoration:none">{{ s.button_label }}</a>{%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "BW · Gaveblok",
  "tag": "section",
  "class": "bw-section",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "phases", "label": "Vis kun i faser", "info": "pre, early, live, sidste · tom = altid" },
    { "type": "select", "id": "layout", "label": "Layout", "options": [ { "value": "card", "label": "Gavekort (forside)" }, { "value": "rules", "label": "Gaveregler (landingsside)" } ], "default": "card" },
    { "type": "text", "id": "eyebrow", "label": "Overlinje", "default": "Gave i Black Week" },
    { "type": "text", "id": "heading_1", "label": "Overskrift linje 1", "default": "Gave med hjem." },
    { "type": "text", "id": "heading_2", "label": "Overskrift linje 2", "default": "Oveni." },
    { "type": "image_picker", "id": "image", "label": "Billede af gaven" },
    { "type": "text", "id": "card_title", "label": "Gavens navn", "default": "AROX Hydration Bottle 1000 ml" },
    { "type": "text", "id": "card_text", "label": "Gavetekst", "default": "Gratis ved køb for mindst 799 kr." },
    { "type": "text", "id": "note", "label": "Note", "default": "Gælder ordrer i Black Week 20.11–30.11.2026. Beløbet regnes efter rabat." },
    { "type": "text", "id": "button_label", "label": "Knap", "default": "Se gaverne" },
    { "type": "url", "id": "button_url", "label": "Knaplink" }
  ],
  "blocks": [
    {
      "type": "rule",
      "name": "Gaveregel",
      "settings": [
        { "type": "text", "id": "number", "label": "Nummer", "default": "01" },
        { "type": "text", "id": "kicker", "label": "Overlinje", "default": "Fra 799 kr." },
        { "type": "text", "id": "title", "label": "Titel", "default": "Gratis AROX Hydration Bottle 1000 ml" },
        { "type": "text", "id": "text", "label": "Tekst", "default": "Lægges automatisk i kurven." }
      ]
    }
  ],
  "presets": [ { "name": "BW · Gaveblok" } ]
}
{% endschema %}
