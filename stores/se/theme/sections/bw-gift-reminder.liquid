{%- comment -%}BLACK WEEK 2026 · boards 05/06 · gift reminder: bottle packshot, "Gave med hjem. Oveni." + rule, "Se gaverne".{%- endcomment -%}
{%- assign s = section.settings -%}
<div class="bw bw-sec bw-gr{% if s.line_top %} bw-sec--line2{% endif %}{% render 'bw-only', phases: s.phases %}">
  <style>
    .bw-gr { display: flex; flex-wrap: wrap; gap: 20px 40px; align-items: center; justify-content: space-between; }
    .bw-gr__l { display: flex; gap: 16px; align-items: center; flex-wrap: wrap; }
    .bw-gr__img { width: clamp(72px, 7vw, 96px); aspect-ratio: 1 / 1; border-radius: 8px; overflow: hidden; background: #f8f8f8; flex: none; }
    .bw-gr__img img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .bw-gr__t { display: grid; gap: 6px; max-width: 560px; }
    .bw-gr__h { font-size: 18px; font-weight: 900; text-transform: uppercase; }
    .bw-gr__p { font-size: 15px; line-height: 1.5; color: var(--bw-grey-200); }
  </style>
  <div class="bw-gr__l">
    <div class="bw-gr__img">
      {%- if s.image != blank -%}{{- s.image | image_url: width: 300 | image_tag: loading: 'lazy', sizes: '96px', alt: s.image.alt | default: 'AROX vattenflaska 1000 ml' -}}{%- else -%}{{- 'product-1' | placeholder_svg_tag -}}{%- endif -%}
    </div>
    <div class="bw-gr__t">
      {%- if s.heading != blank -%}<div class="bw-gr__h">{{ s.heading }}</div>{%- endif -%}
      {%- if s.text != blank -%}<div class="bw-gr__p">{{ s.text }}</div>{%- endif -%}
    </div>
  </div>
  {%- if s.button_label != blank -%}<a href="{{ s.button_url | default: '/pages/black-week-presenter' }}" class="bw-btn bw-btn--outline">{{ s.button_label }}</a>{%- endif -%}
</div>

{% schema %}
{
  "name": "BW · Gave-påmindelse",
  "class": "bw-section",
  "settings": [
    { "type": "text", "id": "phases", "label": "Vis kun i faser", "info": "pre, early, live, sidste · tom = altid" },
    { "type": "image_picker", "id": "image", "label": "Billede" },
    { "type": "text", "id": "heading", "label": "Overskrift", "default": "Gave med hjem. Oveni." },
    { "type": "text", "id": "text", "label": "Tekst", "default": "Gratis ved køb for mindst 799 kr." },
    { "type": "text", "id": "button_label", "label": "Knaptekst", "default": "Se gaverne" },
    { "type": "url", "id": "button_url", "label": "Knaplink", "info": "Tom = /pages/black-week-presenter" },
    { "type": "checkbox", "id": "line_top", "label": "Streg over", "default": false }
  ],
  "presets": [ { "name": "BW · Gave-påmindelse" } ]
}
{% endschema %}
