{%- comment -%}
----------------------------------------------------------------------------------------------------------------------
BLACK WEEK 2026 · head include (rendered from layout/theme.liquid)
----------------------------------------------------------------------------------------------------------------------
Sets the campaign phase on <html> before first paint so phase-specific content never flashes:

  html.bw-pre     nu → fredag 20.11 kl. 12:00            (presale-fase)
  html.bw-early   fredag 20.11 kl. 12:00 → søndag 22.11 kl. 20:00 (tidlig adgang)
  html.bw-live    søndag 22.11 kl. 20:00 → mandag 30.11 kl. 00:00
  html.bw-sidste  mandag 30.11 hele dagen → kl. 23:59
  html.bw-ended   efter mandag 30.11 kl. 23:59

Preview a phase: in the theme editor pick Theme settings → Black Week 2026 → "Vis fase i temaeditoren", or add
?bw_phase=pre|early|live|sidste|ended to any preview URL (remembered for the browser tab; ?bw_phase=auto clears it). Elements hide per phase with the classes bw-hide-<phase>; see snippet bw-only.
{%- endcomment -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800;900&display=swap">
{{- 'bw.css' | asset_url | stylesheet_tag -}}
<script>
  window.BW = {
    times: {
      early: '2026-11-20T12:00:00+01:00',
      live: '2026-11-22T20:00:00+01:00',
      sidste: '2026-11-30T00:00:00+01:00',
      end: '2026-11-30T23:59:00+01:00'
    },
    countdown: {
      pre: { target: '2026-11-20T12:00:00+01:00', top: 'Tidig tillgång startar om', label: 'Fredag 20/11 kl. 12.00' },
      early: { target: '2026-11-22T20:00:00+01:00', top: 'Tidig tillgång slutar om', label: 'Öppet för alla söndag 22/11 kl. 20.00' },
      live: { target: '2026-11-30T23:59:00+01:00', top: 'Black Week slutar om', label: 'Black Week slutar måndag 30/11 kl. 23.59' }
    }
  };
  (function () {
    var t = window.BW.times, now = Date.now(), phase;
    try {
      var q = new URLSearchParams(location.search).get('bw_phase');
      if (q === 'auto') sessionStorage.removeItem('bw_phase');
      else if (/^(pre|early|live|sidste|ended)$/.test(q || '')) sessionStorage.setItem('bw_phase', q);
      phase = sessionStorage.getItem('bw_phase');
    } catch (e) {}
    if (!phase) {
      phase = now < Date.parse(t.early) ? 'pre'
        : now < Date.parse(t.live) ? 'early'
        : now < Date.parse(t.sidste) ? 'live'
        : now < Date.parse(t.end) ? 'sidste' : 'ended';
    }
    {%- if request.design_mode and settings.bw_phase_preview != blank and settings.bw_phase_preview != 'auto' -%}
    phase = {{ settings.bw_phase_preview | json }};
    {%- endif -%}
    window.BW.phase = phase;
    document.documentElement.classList.add('bw-' + phase);
  })();
</script>
<script src="{{ 'bw.js' | asset_url }}" defer></script>
