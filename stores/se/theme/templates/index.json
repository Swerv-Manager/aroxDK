      "type": "bw-faq-short",
      "blocks": {
        "q_1": {
          "type": "item",
          "settings": {
            "question": "När är Black Week?",
            "answer": "Presale för anmälda fredag 20/11 kl. 12.00. Öppet för alla söndag 22/11 kl. 20.00. Black Week slutar måndag 30/11 kl. 23.59 (Cyber Monday)."
          }
        },
        "q_2": {
          "type": "item",
          "settings": {
            "question": "Hur får jag rabatten?",
            "answer": "Rabatten dras automatiskt i varukorgen. Ingen kod behövs. Med 3 för 2 är den billigaste av 3 produkter gratis. Med 4 för 2 är de 2 billigaste av 4 produkter gratis."
          }
        },
        "q_3": {
          "type": "item",
          "settings": {
            "question": "Vilka produkter ingår?",
            "answer": "Produkter märkta Limited edition, 3 för 2 eller 4 för 2. Du hittar dem samlade i de tre Black Week-kollektionerna."
          }
        },
        "q_4": {
          "type": "item",
          "settings": {
            "question": "Vad är Limited Blackout?",
            "answer": "Helsvarta versioner av anti slip grips, fusion grips, metcon-lyftarbältet och elite speed rope. De finns bara under Black Week."
          }
        },
        "q_5": {
          "type": "item",
          "settings": {
            "question": "Hur får jag gåvan?",
            "answer": "De första 100 beställningarna under Black Week får en gratis stålflaska (1,06 l). Det finns ingen beloppsgräns."
          }
        }
