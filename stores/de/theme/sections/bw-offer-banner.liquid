{%- comment -%}BLACK WEEK 2026 · "Tag 3. Betal for 2." banner + product row (board 02 #3for2), ported 1:1 from the design.{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign G = 'max(clamp(20px,calc((100cqw - 767px)*1000),64px),calc((100cqw - 1312px)/2))'
  assign coll = s.collection
  if coll == blank and s.collection_handle != blank
    assign coll = collections[s.collection_handle]
  endif
  if s.products != blank and s.products.count > 0
    assign plist = s.products
  else
    assign plist = coll.products
  endif
-%}
<style>#shopify-section-{{ section.id }} a:hover { opacity: 1; } #shopify-section-{{ section.id }} .bw-card:hover .bw-card__img2 { opacity: 1 !important; }</style>
<div class="bw{% render 'bw-only', phases: s.phases %}" style="container-type:inline-size">
  <div style="background:#0a0a0a">
    <div style="position:relative;height:clamp(340px,32cqw,480px);background:#0a0a0a;overflow:hidden">
      {%- if s.image != blank -%}{{ s.image | image_url: width: 2800 | image_tag: loading: 'lazy', sizes: '100vw', widths: '750,1100,1500,2000,2800', alt: s.image.alt, style: 'position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:50% 40%' }}{%- endif -%}
      <div style="position:absolute;inset:0;background:linear-gradient(180deg,rgba(10,10,10,.2) 0%,rgba(10,10,10,.85) 100%)"></div>
      <div style="position:absolute;left:{{ G }};right:{{ G }};bottom:clamp(28px,3.4cqw,56px);display:grid;gap:12px;color:#fff">
        <span style="justify-self:start;background:#c8232c;color:#fff;font-size:11px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;padding:5px 9px;border-radius:4px">{{ s.badge }}</span>
        <h2 style="margin:0;font-size:clamp(38px,5.2cqw,76px);font-weight:900;text-transform:uppercase;letter-spacing:-.01em;line-height:.95;font-family:inherit;color:#fff">{{ s.heading_1 }}<br>{{ s.heading_2 }}</h2>
      </div>
    </div>
    <div style="padding:32px {{ G }} clamp(48px,calc((100cqw - 767px)*1000),80px);display:grid;gap:24px;color:#fff">
      {%- if s.text != blank -%}<div style="font-size:clamp(15px,1.25cqw,18px);line-height:1.5;max-width:720px;margin-bottom:8px">{{ s.text }}</div>{%- endif -%}
      {%- assign shown = 0 -%}
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(max(160px,calc((100% - 48px)/4)),1fr));gap:16px">
        {%- for p in plist -%}
          {%- if shown >= s.limit -%}{%- break -%}{%- endif -%}
          {%- if p.available == false -%}{%- continue -%}{%- endif -%}
          {%- render 'bw-product-card', product: p -%}
          {%- assign shown = shown | plus: 1 -%}
        {%- endfor -%}
      </div>
      <div style="display:flex;gap:16px;align-items:center;flex-wrap:wrap;justify-content:space-between">
        {%- if s.button_label != blank -%}<a href="{{ s.button_url | default: '#' }}" style="display:inline-flex;align-items:center;height:48px;padding:0 28px;border-radius:999px;background:#fff;color:#111;font-size:15px;font-weight:700;text-decoration:none">{{ s.button_label }}</a>{%- endif -%}
        {%- if s.note != blank -%}<div style="font-size:13px;color:#c9c9c9">{{ s.note }}</div>{%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "BW · Tilbudsbanner",
  "tag": "section",
  "class": "bw-section",
  "settings": [
    { "type": "text", "id": "phases", "label": "Vis kun i faser", "info": "pre, early, live, sidste · tom = altid" },
    { "type": "image_picker", "id": "image", "label": "Billede" },
    { "type": "text", "id": "badge", "label": "Badge", "default": "3 for 2" },
    { "type": "text", "id": "heading_1", "label": "Overskrift linje 1", "default": "Tag 3." },
    { "type": "text", "id": "heading_2", "label": "Overskrift linje 2", "default": "Betal for 2." },
    { "type": "textarea", "id": "text", "label": "Tekst", "default": "Læg 3 varer fra 3 for 2 i kurven, og betal for de 2 dyreste. Den billigste er gratis. Rabatten trækkes automatisk i kurven – ingen kode nødvendig." },
    { "type": "product_list", "id": "products", "label": "Produkter", "limit": 12 },
    { "type": "collection", "id": "collection", "label": "…eller kollektion" },
    { "type": "text", "id": "collection_handle", "label": "…eller kollektions-handle", "default": "black-week-3for2" },
    { "type": "range", "id": "limit", "label": "Antal produkter", "min": 2, "max": 12, "step": 1, "default": 4 },
    { "type": "text", "id": "button_label", "label": "Knap", "default": "Shop 3 for 2" },
    { "type": "url", "id": "button_url", "label": "Knaplink" },
    { "type": "text", "id": "note", "label": "Note", "default": "Fri fragt v. køb over 499 kr. · ellers fragt fra 35 kr." }
  ],
  "presets": [ { "name": "BW · Tilbudsbanner" } ]
}
{% endschema %}
