          "settings": {
            "question": "Wann ist Black Week?",
            "answer": "Early Access für Angemeldete ab Freitag, 20.11., 12:00 Uhr. Für alle ab Sonntag, 22.11., 20:00 Uhr. Black Week endet am Montag, 30.11., 23:59 Uhr (Cyber Monday). Alle Zeiten MEZ."
          }
        },
        "q_2": {
          "type": "item",
          "settings": {
            "question": "Wie bekomme ich den Rabatt?",
            "answer": "Der Rabatt wird automatisch im Warenkorb abgezogen, du brauchst keinen Code. Bei 3 für 2 ist das günstigste von 3 Produkten gratis. Bei 4 für 2 sind die 2 günstigsten von 4 Produkten gratis."
          }
        },
        "q_3": {
          "type": "item",
          "settings": {
            "question": "Welche Produkte sind dabei?",
            "answer": "Produkte mit Limited Edition, 3 für 2 oder 4 für 2. Du findest sie gesammelt in den drei Black-Week-Kollektionen."
          }
        },
        "q_4": {
          "type": "item",
          "settings": {
            "question": "Was ist Limited Blackout?",
            "answer": "Komplett schwarze Editionen der Anti Slip Grips Pro, der Fusion Grips Pro, des Metcon Gewichthebergürtels und des Elite Speed Rope. Es gibt sie nur in der Black Week."
          }
        },
