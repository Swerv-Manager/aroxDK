{%- comment -%}
BLACK WEEK 2026 · boards 04–07 · product grid of a Black Week collection page (or of a chosen collection on the
04–06 pages): Black Week product cards, 4 per row on desktop and 2 on mobile, available products only, 48 per page.
Replaces Impact's main-collection on the Black Week collection templates (main-collection is disabled there).
Markup: snippet bw-coll-grid.
{%- endcomment -%}
{%- assign s = section.settings -%}
{%- assign bw_coll = s.collection | default: collection -%}
<div class="bw bw-cg{% render 'bw-only', phases: s.phases %}" style="container-type:inline-size;padding:{{ s.pad_top }}px var(--bw-gutter) {{ s.pad_bottom }}px">
  {%- if s.heading != blank -%}
    <h2 style="margin:0 0 24px;font-size:clamp(24px,2.6vw,36px);font-weight:900;text-transform:uppercase;letter-spacing:-.005em;line-height:1">{{ s.heading }}</h2>
  {%- endif -%}
  {%- render 'bw-coll-grid', coll: bw_coll, badge: s.badge, offer_only: s.offer_only -%}
</div>

{% schema %}
{
  "name": "BW · Kollektionsgrid",
  "class": "bw-section",
  "settings": [
    { "type": "paragraph", "content": "Viser kollektionens varer som Black Week-produktkort (kun varer der kan købes)." },
    { "type": "text", "id": "phases", "label": "Vis kun i faser", "info": "pre, early, live, sidste · tom = altid" },
    { "type": "collection", "id": "collection", "label": "Kollektion", "info": "Tom = den aktuelle kollektion" },
    { "type": "text", "id": "heading", "label": "Overskrift" },
    { "type": "text", "id": "badge", "label": "Badge på alle kort", "info": "Tom = tilbuddet fra Black Week-kollektionen" },
    { "type": "checkbox", "id": "offer_only", "label": "Black Week-badge kun på kampagnevarer", "default": false },
    { "type": "range", "id": "pad_top", "label": "Afstand top", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "pad_bottom", "label": "Afstand bund", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 24 }
  ],
  "presets": [ { "name": "BW · Kollektionsgrid" } ]
}
{% endschema %}
