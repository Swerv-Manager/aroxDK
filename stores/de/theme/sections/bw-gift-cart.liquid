{%- comment -%}BLACK WEEK 2026 · "Du kan se det i kurven" (board 09): text left, preview of the cart gift line right.{%- endcomment -%}
<style>
  .bw-gk__box { background: #161616; border-radius: 8px; padding: 20px; display: grid; gap: 14px; max-width: 460px; }
  .bw-gk__line { display: flex; gap: 10px; align-items: center; }
  .bw-gk__img { width: 36px; height: 36px; border-radius: 4px; overflow: hidden; background: #f8f8f8; flex: none; }
  .bw-gk__img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .bw-gk__txt { font-size: 13px; line-height: 1.4; font-weight: 600; color: #fff; }
</style>
<div class="bw bw-gk{% render 'bw-only', phases: section.settings.phases %}">
  <div class="bw-sec">
    <div class="bw-grid-2" style="gap:32px 64px">
      <div style="display:grid;gap:12px">
        {%- if section.settings.eyebrow != blank -%}<div class="bw-eyebrow bw-eyebrow--light">{{ section.settings.eyebrow }}</div>{%- endif -%}
        <h2 class="bw-h2" style="font-size:clamp(24px,2.6vw,36px);letter-spacing:-.005em">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<div class="bw-body" style="max-width:440px">{{ section.settings.text }}</div>{%- endif -%}
        {%- if section.settings.link_label != blank -%}<a href="{{ section.settings.link_url | default: '#' }}" class="bw-link" style="justify-self:start">{{ section.settings.link_label }}</a>{%- endif -%}
      </div>
      <div class="bw-gk__box">
        <div class="bw-gk__line">
          <div class="bw-gk__img">{%- if section.settings.image != blank -%}{{ section.settings.image | image_url: width: 120 | image_tag: loading: 'lazy', alt: 'AROX Trinkflasche 1000 ml' }}{%- endif -%}</div>
          <div class="bw-gk__txt">{{ section.settings.line }}</div>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "BW · Gave i kurven",
  "class": "bw-section",
  "settings": [
    { "type": "text", "id": "phases", "label": "Vis kun i faser", "info": "pre, early, live, sidste · tom = altid" },
    { "type": "text", "id": "eyebrow", "label": "Overlinje", "default": "I kurven" },
    { "type": "text", "id": "heading", "label": "Overskrift", "default": "Du kan se det i kurven." },
    { "type": "textarea", "id": "text", "label": "Tekst", "default": "Baren øverst i kurven viser, hvor langt du er fra næste gave. Rabatten trækkes automatisk." },
    { "type": "text", "id": "link_label", "label": "Link", "default": "Se single offers" },
    { "type": "url", "id": "link_url", "label": "Link-URL" },
    { "type": "image_picker", "id": "image", "label": "Gavebillede" },
    { "type": "text", "id": "line", "label": "Gavelinje", "default": "Gratis ved køb for mindst 799 kr." }
  ],
  "presets": [{ "name": "BW · Gave i kurven" }]
}
{% endschema %}
