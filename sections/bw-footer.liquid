{%- comment -%}
BLACK WEEK 2026 · Footer (board 12), ported 1:1 from the design: newsletter signup (Shopify customer form) + link columns,
then the bottom row with white logo, payment pills and the legal line.
Black Week column = blocks; Information column = the menu picked in the settings.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign G = 'max(clamp(20px,calc((100cqw - 767px)*1000),64px),calc((100cqw - 1312px)/2))'
  assign PY = 'clamp(48px,calc((100cqw - 767px)*1000),80px)'
  assign colh = 'font-size:12px;font-weight:800;letter-spacing:.2em;text-transform:uppercase;color:#9b9b9b'
  assign lnk = 'display:flex;align-items:center;min-height:40px;color:#fff;text-decoration:none'
  assign pays = s.payments | split: ','
-%}
<style>
  #shopify-section-{{ section.id }} input::placeholder { color: #6e6e6e; }
  #shopify-section-{{ section.id }} a:hover { opacity: 1; }
  #shopify-section-{{ section.id }} .bwf-contact { display: grid; gap: 12px; }
  #shopify-section-{{ section.id }} .bwf-contact p { margin: 0; }
  #shopify-section-{{ section.id }} .bwf-contact p:last-child { color: #e4e4e4; }
</style>
<div class="bw{% render 'bw-only', phases: s.phases %}" style="container-type:inline-size">
  <div style="background:#0a0a0a;color:#fff">
    <div style="padding:{{ PY }} {{ G }};display:grid;grid-template-columns:repeat(auto-fit,minmax(max(300px,calc((100% - 64px)/2)),1fr));gap:40px 64px">
      <div style="display:grid;gap:14px;align-content:start">
        <div style="{{ colh }}">{{ s.eyebrow }}</div>
        <div style="font-size:clamp(28px,3cqw,44px);font-weight:900;text-transform:uppercase;line-height:1;letter-spacing:-.01em">{{ s.heading }}</div>
        <div style="font-size:15px;line-height:1.5;color:#e4e4e4;max-width:460px">{{ s.text }}</div>
        {%- form 'customer', id: 'bw-footer-form', style: 'margin:0;display:grid;gap:14px' -%}
          {%- if form.posted_successfully? -%}
            <div style="font-size:15px;font-weight:700">{{ s.success }}</div>
          {%- else -%}
            <input type="hidden" name="contact[tags]" value="{{ s.tags | escape }}" data-bw-tags>
            <input type="hidden" name="contact[accepts_marketing]" value="true">
            <div style="display:flex;gap:8px;flex-wrap:wrap;max-width:520px">
              <input type="email" name="contact[email]" required placeholder="{{ s.ph_email | escape }}" aria-label="{{ s.ph_email | escape }}" style="flex:1 1 220px;height:52px;border-radius:999px;border:1px solid #e4e4e4;background:#fff;color:#111;padding:0 20px;font:inherit;font-size:16px;margin:0;box-sizing:border-box;min-width:0">
              <button type="submit" style="height:52px;padding:0 28px;border-radius:999px;border:0;background:#fff;color:#111;font:inherit;font-size:15px;font-weight:700;cursor:pointer">{{ s.button }}</button>
            </div>
            <label style="display:flex;gap:12px;align-items:center;min-height:44px;font-size:13px;line-height:1.4;color:#e4e4e4"><input type="checkbox" data-bw-sms style="width:20px;height:20px;accent-color:#fff;flex:none;margin:0"><span>{{ s.consent_sms }}</span></label>
            {%- if form.errors -%}<div style="font-size:13px;color:#ffb4b4">{{ form.errors | default_errors }}</div>{%- endif -%}
          {%- endif -%}
        {%- endform -%}
        <div style="font-size:12px;color:#9b9b9b">{{ s.legal_small }}</div>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:28px">
        <div style="display:grid;gap:4px;align-content:start;font-size:14px">
          <div style="{{ colh }}">{{ s.bw_title }}</div>
          {%- for block in section.blocks -%}<a href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }} style="{{ lnk }}">{{ block.settings.label }}</a>{%- endfor -%}
        </div>
        {%- assign menu = linklists[s.menu] -%}
        {%- if menu.links.size > 0 -%}
          <div style="display:grid;gap:4px;align-content:start;font-size:14px">
            <div style="{{ colh }}">{{ s.menu_title }}</div>
            {%- for link in menu.links -%}<a href="{{ link.url }}" style="{{ lnk }}">{{ link.title }}</a>{%- endfor -%}
          </div>
        {%- endif -%}
        <div style="display:grid;gap:12px;align-content:start;font-size:14px">
          <div style="{{ colh }}">{{ s.contact_title }}</div>
          <div class="bwf-contact">{{ s.contact }}</div>
        </div>
      </div>
    </div>
    <div style="padding:20px {{ G }} 28px;border-top:1px solid #222;display:flex;flex-wrap:wrap;gap:14px 24px;align-items:center;justify-content:space-between;font-size:12px;color:#9b9b9b">
      {%- if s.logo != blank -%}{%- capture lst -%}width:{{ s.logo_width }}px;height:auto;flex:none;max-width:none;display:block{%- endcapture -%}{{ s.logo | image_url: width: 400 | image_tag: loading: 'lazy', alt: shop.name, style: lst }}{%- endif -%}
      <div style="display:flex;gap:6px;flex-wrap:wrap">{%- for pm in pays -%}<span style="border:1px solid #333;border-radius:4px;padding:3px 8px;color:#e4e4e4">{{ pm | strip }}</span>{%- endfor -%}</div>
      <span>{{ s.copyright }}</span>
    </div>
  </div>
</div>
<script>
  (function () {
    var f = document.getElementById('bw-footer-form');
    if (!f) return;
    f.addEventListener('submit', function () {
      var sms = f.querySelector('[data-bw-sms]'), tags = f.querySelector('[data-bw-tags]');
      if (sms && tags && sms.checked && tags.value.indexOf('sms') === -1) tags.value += ',sms';
    });
  })();
</script>

{% schema %}
{
  "name": "BW · Footer",
  "tag": "section",
  "class": "bw-section",
  "enabled_on": { "groups": ["footer"] },
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "phases", "label": "Vis kun i faser", "info": "pre, early, live, sidste · tom = altid" },
    { "type": "header", "content": "Tilmelding" },
    { "type": "text", "id": "eyebrow", "label": "Overlinje", "default": "Black Week · SMS + mail" },
    { "type": "text", "id": "heading", "label": "Overskrift", "default": "Tilmeld dig VIP nyhedsbrevet" },
    { "type": "textarea", "id": "text", "label": "Tekst", "default": "Modtag rabatkoder, fri fragt kampagner, eksklusive tilbud og meget mere. I Black Week får du besked, når tilbuddene åbner." },
    { "type": "text", "id": "ph_email", "label": "Felt: e-mail", "default": "E-mail" },
    { "type": "text", "id": "button", "label": "Knaptekst", "default": "Abonnér" },
    { "type": "text", "id": "consent_sms", "label": "Samtykke SMS", "default": "Ja tak til nyheder og tilbud på SMS" },
    { "type": "text", "id": "legal_small", "label": "Småt", "default": "Du kan altid afmelde dig igen. Læs mere i vores privatlivspolitik." },
    { "type": "text", "id": "success", "label": "Tak-tekst", "default": "Tak. Du er på listen." },
    { "type": "text", "id": "tags", "label": "Kundetags", "default": "newsletter", "info": "\"sms\" tilføjes, når SMS er valgt." },
    { "type": "header", "content": "Kolonner" },
    { "type": "text", "id": "bw_title", "label": "Titel på Black Week-kolonnen (links = blokke)", "default": "Black Week" },
    { "type": "link_list", "id": "menu", "label": "Menu (Information)" },
    { "type": "text", "id": "menu_title", "label": "Menutitel", "default": "Information" },
    { "type": "text", "id": "contact_title", "label": "Titel kundeservice", "default": "Kundeservice" },
    { "type": "richtext", "id": "contact", "label": "Kundeservice", "default": "<p>support@aroxfitness.com</p><p>+45 21716275</p><p>Hverdage 10:00–13:00</p>" },
    { "type": "header", "content": "Bund" },
    { "type": "image_picker", "id": "logo", "label": "Logo (hvidt)" },
    { "type": "range", "id": "logo_width", "label": "Logobredde", "min": 60, "max": 240, "step": 2, "unit": "px", "default": 126 },
    { "type": "text", "id": "payments", "label": "Betalingsmetoder (kommasepareret)", "default": "Dankort, Visa, Mastercard, MobilePay" },
    { "type": "text", "id": "copyright", "label": "Juridisk linje", "default": "© 2026, Arox Fitness Denmark. · Sai Fitness ApS · CVR 42582735 · Skolegade 7, 8000 Aarhus C" }
  ],
  "blocks": [
    { "type": "link", "name": "Black Week-link", "settings": [ { "type": "text", "id": "label", "label": "Tekst", "default": "3 for 2" }, { "type": "url", "id": "link", "label": "Link" } ] }
  ],
  "presets": [ { "name": "BW · Footer" } ]
}
{% endschema %}
