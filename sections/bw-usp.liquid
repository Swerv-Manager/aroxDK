{%- comment -%}BLACK WEEK 2026 · Text with icons above the footer (board 12, replaces the live text-with-icons), ported 1:1 from the design.{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign G = 'max(clamp(20px,calc((100cqw - 767px)*1000),64px),calc((100cqw - 1312px)/2))'
-%}
<div class="bw{% render 'bw-only', phases: s.phases %}" style="container-type:inline-size">
  <div style="background:#0a0a0a;color:#fff;border-top:1px solid #2b2b2b;padding:32px {{ G }};display:grid;grid-template-columns:repeat(auto-fit,minmax(max(220px,calc((100% - 64px)/3)),1fr));gap:24px 32px">
    {%- for block in section.blocks -%}
      <div {{ block.shopify_attributes }} style="display:flex;gap:14px;align-items:flex-start">
        {%- case block.settings.icon -%}
          {%- when 'truck' -%}<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="flex:none"><path d="M1 3h15v13H1z"></path><path d="M16 8h4l3 3v5h-7"></path><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
          {%- when 'store' -%}<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="flex:none"><path d="M3 9l1-5h16l1 5"></path><path d="M3 9h18v2a3 3 0 0 1-6 0 3 3 0 0 1-6 0 3 3 0 0 1-6 0z"></path><path d="M5 13v8h14v-8"></path></svg>
          {%- else -%}<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="flex:none"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"></path></svg>
        {%- endcase -%}
        <div style="display:grid;gap:4px"><div style="font-size:15px;font-weight:800">{{ block.settings.title }}</div>{%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" style="font-size:14px;color:#c9c9c9;text-decoration:none">{{ block.settings.text }}</a>{%- else -%}<div style="font-size:14px;color:#c9c9c9">{{ block.settings.text }}</div>{%- endif -%}</div>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "BW · Fordele",
  "tag": "section",
  "class": "bw-section",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "phases", "label": "Vis kun i faser", "info": "pre, early, live, sidste · tom = altid" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Fordel",
      "settings": [
        { "type": "select", "id": "icon", "label": "Ikon", "options": [ { "value": "truck", "label": "Fragt" }, { "value": "store", "label": "Butik" }, { "value": "phone", "label": "Telefon" } ], "default": "truck" },
        { "type": "text", "id": "title", "label": "Titel", "default": "Fri fragt over 499 kr." },
        { "type": "text", "id": "text", "label": "Tekst", "default": "Vi leverer med GLS hos Arox Fitness" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [ { "name": "BW · Fordele" } ]
}
{% endschema %}
