{%- comment -%}
BLACK WEEK 2026 · boards 04/05/06 · large offer image with text.
Layout "overlay": text on the image bottom-left with a dark gradient (04 Limited blackout, 05 Tag 3. Betal for 2.).
Layout "stacked": image band with badge, text below on black (06 Tag 4. Betal for 2.).
Heading: one line per line break.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign bw_lines = s.heading | newline_to_br
-%}
<div class="bw bw-oh bw-oh--{{ s.layout }}{% render 'bw-only', phases: s.phases %}">
  <style>
    #shopify-section-{{ section.id }} .bw-oh__img { object-position: {{ s.focal_x }}% {{ s.focal_y }}%; }
    .bw-oh--overlay { position: relative; min-height: {{ s.min_height_mobile }}px; overflow: hidden; display: flex; align-items: flex-end; }
    @media (min-width: 768px) { .bw-oh--overlay { min-height: {{ s.min_height }}px; } }
    .bw-oh--overlay .bw-oh__media { position: absolute; inset: 0; }
    .bw-oh__media { position: relative; overflow: hidden; background: var(--bw-surface); }
    .bw-oh__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
    .bw-oh__scrim { position: absolute; inset: 0; }
    .bw-oh--overlay .bw-oh__scrim { background: linear-gradient(180deg, rgba(10,10,10,{{ s.scrim_top | divided_by: 100.0 }}) 0%, rgba(10,10,10,{{ s.scrim_bottom | divided_by: 100.0 }}) 100%); }
    .bw-oh--stacked .bw-oh__media { height: clamp(320px, 30vw, 460px); }
    .bw-oh--stacked .bw-oh__scrim { background: rgba(10,10,10,{{ s.scrim_bottom | divided_by: 100.0 }}); }
    .bw-oh--stacked .bw-oh__media .bw-badge { position: absolute; top: 16px; left: var(--bw-gutter); }
    .bw-oh__txt { position: relative; padding: 32px var(--bw-gutter); display: grid; gap: 16px; max-width: 820px; }
    .bw-oh--overlay .bw-oh__txt { padding-bottom: clamp(32px, 4.4vw, 72px); padding-top: clamp(32px, 4.4vw, 72px); }
    .bw-oh--stacked .bw-oh__txt { max-width: none; padding-top: clamp(28px, 3.4vw, 56px); padding-bottom: var(--bw-pad-y); }
    .bw-oh__h { margin: 0; font-size: clamp(42px, 6.6vw, 100px); font-weight: 900; text-transform: uppercase; letter-spacing: -.015em; line-height: .95; }
    .bw-oh__p { font-size: clamp(15px, 1.25vw, 18px); line-height: 1.5; color: var(--bw-grey-200); max-width: 600px; }
  </style>
  <div class="bw-oh__media">
    {%- if s.image != blank -%}
      {{- s.image | image_url: width: 2400 | image_tag: class: 'bw-oh__img', loading: 'lazy', sizes: '100vw', widths: '600,900,1200,1600,2000,2400', alt: s.image.alt | default: s.heading | escape -}}
    {%- else -%}
      {{- 'lifestyle-1' | placeholder_svg_tag: 'bw-oh__img' -}}
    {%- endif -%}
    <div class="bw-oh__scrim"></div>
    {%- if s.layout == 'stacked' and s.badge != blank -%}<span class="bw-badge">{{ s.badge }}</span>{%- endif -%}
  </div>
  <div class="bw-oh__txt">
    {%- if s.layout == 'overlay' and s.badge != blank -%}<span class="bw-badge">{{ s.badge }}</span>{%- endif -%}
    {%- if s.eyebrow != blank -%}<div class="bw-eyebrow {% if s.layout == 'overlay' %}bw-eyebrow--white{% endif %}">{{ s.eyebrow }}</div>{%- endif -%}
    {%- if s.heading != blank -%}<{{ s.heading_tag }} class="bw-oh__h">{{ bw_lines }}</{{ s.heading_tag }}>{%- endif -%}
    {%- if s.text != blank -%}<div class="bw-oh__p">{{ s.text }}</div>{%- endif -%}
    {%- if s.button_label != blank -%}<a href="{{ s.button_url | default: collection.url }}" class="bw-btn">{{ s.button_label }}</a>{%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "BW · Tilbudsbillede",
  "class": "bw-section",
  "settings": [
    { "type": "text", "id": "phases", "label": "Vis kun i faser", "info": "pre, early, live, sidste · tom = altid" },
    { "type": "select", "id": "layout", "label": "Layout", "options": [ { "value": "overlay", "label": "Tekst på billedet" }, { "value": "stacked", "label": "Billedbånd + tekst under" } ], "default": "overlay" },
    { "type": "image_picker", "id": "image", "label": "Billede" },
    { "type": "range", "id": "focal_x", "label": "Billedfokus vandret", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
    { "type": "range", "id": "focal_y", "label": "Billedfokus lodret", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 40 },
    { "type": "range", "id": "scrim_top", "label": "Mørk overlay top", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 25 },
    { "type": "range", "id": "scrim_bottom", "label": "Mørk overlay bund / båndet", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 88 },
    { "type": "range", "id": "min_height", "label": "Højde desktop", "min": 300, "max": 800, "step": 10, "unit": "px", "default": 520 },
    { "type": "range", "id": "min_height_mobile", "label": "Højde mobil", "min": 300, "max": 800, "step": 10, "unit": "px", "default": 480 },
    { "type": "text", "id": "badge", "label": "Badge", "default": "3 for 2" },
    { "type": "text", "id": "eyebrow", "label": "Overlinje", "default": "Black Week 20.11–30.11.2026" },
    { "type": "textarea", "id": "heading", "label": "Overskrift", "info": "Linjeskift = ny linje", "default": "Tag 3.\nBetal for 2." },
    { "type": "select", "id": "heading_tag", "label": "Overskriftsniveau", "options": [ { "value": "h1", "label": "H1" }, { "value": "h2", "label": "H2" } ], "default": "h2" },
    { "type": "textarea", "id": "text", "label": "Tekst", "default": "Bland pro grips, shorts, hoodies og performance tights. Den billigste af de 3 er gratis." },
    { "type": "text", "id": "button_label", "label": "Knaptekst" },
    { "type": "url", "id": "button_url", "label": "Knaplink", "info": "Tom = kollektionen" }
  ],
  "presets": [ { "name": "BW · Tilbudsbillede" } ]
}
{% endschema %}
