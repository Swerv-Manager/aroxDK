{%- comment -%}BLACK WEEK 2026 · Presale-CTA bjælke (03 Landingsside · kun i presale som standard){%- endcomment -%}
{%- assign s = section.settings -%}
<style>
  #shopify-section-{{ section.id }} .bw-cta { padding: var(--bw-pad-y) var(--bw-gutter); display: flex; flex-wrap: wrap; gap: 20px 40px; align-items: center; justify-content: space-between; border-top: 1px solid #2b2b2b; }
  #shopify-section-{{ section.id }} .bw-cta__h { font-size: clamp(24px, 2.6vw, 36px); font-weight: 900; text-transform: uppercase; line-height: 1; }
  #shopify-section-{{ section.id }} .bw-cta__d { font-size: 15px; color: var(--bw-grey-c9); }
  #shopify-section-{{ section.id }} .bw-cta__acts { display: flex; gap: 16px; align-items: center; flex-wrap: wrap; }
</style>
<div class="bw{% render 'bw-only', phases: s.phases %}">
  <div class="bw-cta">
    <div style="display:grid;gap:8px">
      {%- if s.eyebrow != blank -%}<div class="bw-eyebrow bw-eyebrow--light">{{ s.eyebrow }}</div>{%- endif -%}
      <div class="bw-cta__h">{{ s.heading }}</div>
      {%- if s.text != blank -%}<div class="bw-cta__d">{{ s.text }}</div>{%- endif -%}
    </div>
    <div class="bw-cta__acts">
      {%- if s.button_label != blank -%}<a href="{{ s.button_link | default: '#' }}" class="bw-btn">{{ s.button_label }}</a>{%- endif -%}
      {%- if s.link_label != blank -%}<a href="{{ s.link | default: '#' }}" class="bw-link">{{ s.link_label }}</a>{%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "BW · CTA-bjælke",
  "tag": "section",
  "class": "bw-section",
  "settings": [
    { "type": "text", "id": "phases", "label": "Vis kun i faser", "info": "pre, early, live, sidste · tom = altid", "default": "pre" },
    { "type": "text", "id": "eyebrow", "label": "Overlinje", "default": "Presale" },
    { "type": "text", "id": "heading", "label": "Overskrift", "default": "Shop før alle andre." },
    { "type": "text", "id": "text", "label": "Tekst", "default": "Presale for tilmeldte fredag 20.11 kl. 12:00 · Åbent for alle søndag 22.11 kl. 20:00" },
    { "type": "text", "id": "button_label", "label": "Knaptekst", "default": "Tilmeld dig presale" },
    { "type": "url", "id": "button_link", "label": "Knaplink" },
    { "type": "text", "id": "link_label", "label": "Linktekst", "default": "Vilkår og FAQ" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "presets": [ { "name": "BW · CTA-bjælke" } ]
}
{% endschema %}
