{%- comment -%}
BLACK WEEK 2026 · Image + text + product row (board 02 "Limited Blackout" and "4 for 2" blocks), ported 1:1 from the design.
Products: picked list, else the chosen collection, else the collection handle (renders without products until it exists).
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign G = 'max(clamp(20px,calc((100cqw - 767px)*1000),64px),calc((100cqw - 1312px)/2))'
  assign PY = 'clamp(48px,calc((100cqw - 767px)*1000),80px)'
  assign coll = s.collection
  if coll == blank and s.collection_handle != blank
    assign coll = collections[s.collection_handle]
  endif
  if s.products != blank and s.products.count > 0
    assign plist = s.products
  else
    assign plist = coll.products
  endif
  if s.heading_size == 'xl'
    assign hs = 'font-size:clamp(38px,5.2cqw,76px);line-height:.95'
  else
    assign hs = 'font-size:clamp(34px,4.6cqw,68px);line-height:1'
  endif
-%}
<style>#shopify-section-{{ section.id }} a:hover { opacity: 1; } #shopify-section-{{ section.id }} .bw-card:hover .bw-card__img2 { opacity: 1 !important; }</style>
<div class="bw{% render 'bw-only', phases: s.phases %}" style="container-type:inline-size">
  <div style="background:#0a0a0a;color:#fff;padding:{{ PY }} {{ G }};display:grid;gap:24px">
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(max(300px,calc((100% - 48px)/2)),1fr));gap:32px 48px;align-items:center;margin-bottom:8px">
      <div style="position:relative;aspect-ratio:5/4;border-radius:8px;overflow:hidden;background:#111">
        {%- if s.image != blank -%}{%- capture imgst -%}position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:{{ s.object_position }}{%- endcapture -%}{{ s.image | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '(min-width: 768px) 50vw, 100vw', widths: '600,900,1200,1400', alt: s.image.alt, style: imgst }}{%- endif -%}
        {%- if s.overlay > 0 -%}<div style="position:absolute;inset:0;background:rgba(10,10,10,{{ s.overlay | divided_by: 100.0 }})"></div>{%- endif -%}
        {%- if s.badge != blank -%}<span style="position:absolute;top:14px;left:14px;background:#c8232c;color:#fff;font-size:11px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;padding:5px 9px;border-radius:4px">{{ s.badge }}</span>{%- endif -%}
      </div>
      <div style="display:grid;gap:16px">
        {%- if s.eyebrow != blank -%}<div style="font-size:12px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:#9b9b9b">{{ s.eyebrow }}</div>{%- endif -%}
        <h2 style="margin:0;{{ hs }};font-weight:900;text-transform:uppercase;letter-spacing:-.01em;font-family:inherit;color:#fff">{{ s.heading_1 }}{% if s.heading_2 != blank %}<br>{{ s.heading_2 }}{% endif %}</h2>
        {%- if s.text != blank -%}<div style="font-size:clamp(15px,1.25cqw,18px);line-height:1.5;color:#e4e4e4;max-width:{{ s.text_max }}px">{{ s.text }}</div>{%- endif -%}
        {%- if s.button_label != blank -%}<a href="{{ s.button_url | default: '#' }}" style="justify-self:start;display:inline-flex;align-items:center;height:48px;padding:0 28px;border-radius:999px;background:#fff;color:#111;font-size:15px;font-weight:700;text-decoration:none">{{ s.button_label }}</a>{%- endif -%}
      </div>
    </div>
    {%- assign shown = 0 -%}
    <div style="display:grid;gap:24px">
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(max(160px,calc((100% - 48px)/4)),1fr));gap:16px">
        {%- for p in plist -%}
          {%- if shown >= s.limit -%}{%- break -%}{%- endif -%}
          {%- if p.available == false -%}{%- continue -%}{%- endif -%}
          {%- render 'bw-product-card', product: p -%}
          {%- assign shown = shown | plus: 1 -%}
        {%- endfor -%}
      </div>
      {%- if s.footer == 'button' -%}
        <div style="display:flex;gap:16px;align-items:center;flex-wrap:wrap;justify-content:space-between">
          {%- if s.button2_label != blank -%}<a href="{{ s.button2_url | default: '#' }}" style="display:inline-flex;align-items:center;height:48px;padding:0 28px;border-radius:999px;border:1.5px solid #fff;color:#fff;font-size:15px;font-weight:700;text-decoration:none">{{ s.button2_label }}</a>{%- endif -%}
          {%- if s.note != blank -%}<div style="font-size:13px;color:#c9c9c9">{{ s.note }}</div>{%- endif -%}
        </div>
      {%- elsif s.note != blank -%}
        <div style="font-size:13px;color:#9b9b9b">{{ s.note }}</div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "BW · Billede + produkter",
  "tag": "section",
  "class": "bw-section",
  "settings": [
    { "type": "text", "id": "phases", "label": "Vis kun i faser", "info": "pre, early, live, sidste · tom = altid" },
    { "type": "image_picker", "id": "image", "label": "Billede" },
    { "type": "text", "id": "object_position", "label": "Billedfokus", "default": "50% 55%" },
    { "type": "range", "id": "overlay", "label": "Mørk overlay", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 0 },
    { "type": "text", "id": "badge", "label": "Badge på billede", "default": "Limited" },
    { "type": "text", "id": "eyebrow", "label": "Overlinje", "default": "Limited edition · Limited blackout" },
    { "type": "text", "id": "heading_1", "label": "Overskrift linje 1", "default": "Limited blackout." },
    { "type": "text", "id": "heading_2", "label": "Overskrift linje 2", "default": "Kun i Black Week." },
    { "type": "select", "id": "heading_size", "label": "Overskriftsstørrelse", "options": [ { "value": "lg", "label": "Stor" }, { "value": "xl", "label": "Ekstra stor" } ], "default": "lg" },
    { "type": "textarea", "id": "text", "label": "Tekst", "default": "Helsort udgave af anti slip grips, fusion grips, Elite-bæltet og speedrope elite. Kun i Black Week." },
    { "type": "range", "id": "text_max", "label": "Tekstbredde", "min": 400, "max": 720, "step": 20, "unit": "px", "default": 520 },
    { "type": "text", "id": "button_label", "label": "Knap", "default": "Se single offers" },
    { "type": "url", "id": "button_url", "label": "Knaplink" },
    { "type": "header", "content": "Produkter" },
    { "type": "product_list", "id": "products", "label": "Produkter", "limit": 12 },
    { "type": "collection", "id": "collection", "label": "…eller kollektion" },
    { "type": "text", "id": "collection_handle", "label": "…eller kollektions-handle", "default": "black-week-limited-edition" },
    { "type": "range", "id": "limit", "label": "Antal produkter", "min": 2, "max": 12, "step": 1, "default": 4 },
    { "type": "select", "id": "footer", "label": "Under produkterne", "options": [ { "value": "note", "label": "Kun note" }, { "value": "button", "label": "Knap + note" } ], "default": "note" },
    { "type": "text", "id": "button2_label", "label": "Knap under produkter", "default": "Se alle" },
    { "type": "url", "id": "button2_url", "label": "Link under produkter" },
    { "type": "text", "id": "note", "label": "Note", "default": "Fri fragt v. køb over 499 kr. · ellers fragt fra 35 kr." }
  ],
  "presets": [ { "name": "BW · Billede + produkter" } ]
}
{% endschema %}
