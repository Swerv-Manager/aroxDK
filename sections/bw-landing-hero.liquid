{%- comment -%}BLACK WEEK 2026 · Landing page hero "Black Week. Sådan virker det." (board 03), ported 1:1 from the design.{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign G = 'max(clamp(20px,calc((100cqw - 767px)*1000),64px),calc((100cqw - 1312px)/2))'
-%}
<style>
  #shopify-section-{{ section.id }} .bwlh-btn { background: #fff; }
  #shopify-section-{{ section.id }} .bwlh-btn:hover { background: #e4e4e4; opacity: 1; }
</style>
<div class="bw{% render 'bw-only', phases: s.phases %}" style="container-type:inline-size">
  <div style="position:relative;min-height:clamp(600px,40cqw,600px);background:#0a0a0a;overflow:hidden;color:#fff;display:flex;align-items:flex-end;justify-content:flex-end">
    {%- if s.image != blank -%}{{ s.image | image_url: width: 2800 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '100vw', widths: '750,1100,1500,2000,2800', alt: s.image.alt, style: 'position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:33% 40%' }}{%- endif -%}
    <div style="position:absolute;inset:0;background:linear-gradient(180deg,rgba(10,10,10,.25) 0%,rgba(10,10,10,.35) 40%,rgba(10,10,10,.9) 100%)"></div>
    <div style="position:absolute;inset:0;background:linear-gradient(90deg,rgba(10,10,10,0) 30%,rgba(10,10,10,.7) 100%)"></div>
    <div style="position:relative;padding:clamp(32px,4.4cqw,72px) {{ G }};display:grid;gap:18px;width:min(640px,100%);box-sizing:border-box">
      <div style="font-size:12px;font-weight:800;letter-spacing:.1em;text-transform:uppercase">{{ s.eyebrow }}</div>
      <h1 style="margin:0;font-size:clamp(42px,6.6cqw,100px);font-weight:900;text-transform:uppercase;letter-spacing:-.015em;line-height:.95;font-family:inherit;color:#fff">{{ s.heading_1 }}<br>{{ s.heading_2 }}</h1>
      <div style="font-size:clamp(15px,1.25cqw,18px);line-height:1.5;color:#e4e4e4">{{ s.text }}</div>
      {%- if s.button_label != blank -%}
        <div style="display:flex;gap:10px;flex-wrap:wrap"><a href="{{ s.button_url | default: '#' }}" class="bwlh-btn" style="display:inline-flex;align-items:center;justify-content:center;gap:10px;height:48px;padding:0 28px;border-radius:999px;font-size:15px;font-weight:700;text-decoration:none;color:#111">{{ s.button_label }}<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="flex:none"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="13 6 19 12 13 18"></polyline></svg></a></div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "BW · Landingshero",
  "tag": "section",
  "class": "bw-section",
  "settings": [
    { "type": "text", "id": "phases", "label": "Vis kun i faser", "info": "pre, early, live, sidste · tom = altid" },
    { "type": "image_picker", "id": "image", "label": "Billede" },
    { "type": "text", "id": "eyebrow", "label": "Overlinje", "default": "Black Week 20.11–30.11.2026" },
    { "type": "text", "id": "heading_1", "label": "Overskrift linje 1", "default": "Black Week." },
    { "type": "text", "id": "heading_2", "label": "Overskrift linje 2", "default": "Sådan virker det." },
    { "type": "textarea", "id": "text", "label": "Tekst", "default": "Limited edition, 3 for 2 og 4 for 2 på udvalgte varer. Rabatten trækkes automatisk i kurven – ingen kode nødvendig." },
    { "type": "text", "id": "button_label", "label": "Knap", "default": "Se single offers" },
    { "type": "url", "id": "button_url", "label": "Knaplink" }
  ],
  "presets": [ { "name": "BW · Landingshero" } ]
}
{% endschema %}
