{%- comment -%}BLACK WEEK 2026 · Brand line "Arox er dansk & det er vi stolte af" (board 02, replaces the live rich text), ported 1:1 from the design.{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign G = 'max(clamp(20px,calc((100cqw - 767px)*1000),64px),calc((100cqw - 1312px)/2))'
  assign PY = 'clamp(48px,calc((100cqw - 767px)*1000),80px)'
-%}
<div class="bw{% render 'bw-only', phases: s.phases %}" style="container-type:inline-size">
  <div style="background:#0a0a0a;color:#fff;padding:{{ PY }} {{ G }};display:grid;gap:14px;justify-items:center;text-align:center">
    <h2 style="margin:0;font-size:clamp(26px,3cqw,40px);font-weight:900;text-transform:uppercase;line-height:1.05;letter-spacing:-.005em;font-family:inherit;color:#fff">{{ s.heading }}</h2>
    {%- if s.text != blank -%}<div style="font-size:16px;line-height:1.6;color:#c9c9c9;max-width:560px">{{ s.text }}</div>{%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "BW · Brandtekst",
  "tag": "section",
  "class": "bw-section",
  "settings": [
    { "type": "text", "id": "phases", "label": "Vis kun i faser", "info": "pre, early, live, sidste · tom = altid" },
    { "type": "text", "id": "heading", "label": "Overskrift", "default": "Arox er dansk & det er vi stolte af" },
    { "type": "textarea", "id": "text", "label": "Tekst", "default": "Skabt af atleter, delt med alle som ønsker en aktiv livsstil." }
  ],
  "presets": [ { "name": "BW · Brandtekst" } ]
}
{% endschema %}
