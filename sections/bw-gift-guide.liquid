{%- comment -%}BLACK WEEK 2026 · Gaveguide "Gaver under" med prisfaner (02 Forside){%- endcomment -%}
{%- assign s = section.settings -%}
<style>
  #shopify-section-{{ section.id }} .bw-gu__tabs { display: flex; gap: 8px; overflow-x: auto; }
  #shopify-section-{{ section.id }} .bw-gu__tab { flex: none; height: 44px; padding: 0 20px; border-radius: 999px; font-family: var(--bw-font); font-size: 14px; font-weight: 800; display: inline-flex; align-items: center; cursor: pointer; border: 1.5px solid #fff; color: #fff; background: transparent; }
  #shopify-section-{{ section.id }} .bw-gu__tab[aria-selected="true"] { background: #fff; color: var(--bw-ink); }
  #shopify-section-{{ section.id }} .bw-gu__panel[hidden] { display: none; }
</style>
<div class="bw{% render 'bw-only', phases: s.phases %}">
  <div class="bw-sec bw-sec--line" id="gaver-under">
    <div class="bw-head">
      {%- if s.eyebrow != blank -%}<div class="bw-eyebrow">{{ s.eyebrow }}</div>{%- endif -%}
      <h2 class="bw-h2">{{ s.heading }}</h2>
    </div>
    <div class="bw-gu__tabs" role="tablist">
      {%- for block in section.blocks -%}
        <button type="button" class="bw-gu__tab" role="tab" id="bw-gu-tab-{{ block.id }}" aria-controls="bw-gu-panel-{{ block.id }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" {{ block.shopify_attributes }}>{{ block.settings.label }}</button>
      {%- endfor -%}
    </div>
    {%- for block in section.blocks -%}
      <div class="bw-gu__panel" role="tabpanel" id="bw-gu-panel-{{ block.id }}" aria-labelledby="bw-gu-tab-{{ block.id }}"{% unless forloop.first %} hidden{% endunless %}>
        {%- render 'bw-product-grid', products: block.settings.products, limit: 4 -%}
      </div>
    {%- endfor -%}
  </div>
</div>
<script>
  (function () {
    var root = document.getElementById('shopify-section-{{ section.id }}');
    if (!root) return;
    root.addEventListener('click', function (e) {
      var tab = e.target.closest('.bw-gu__tab');
      if (!tab) return;
      root.querySelectorAll('.bw-gu__tab').forEach(function (t) {
        var on = t === tab;
        t.setAttribute('aria-selected', on ? 'true' : 'false');
        var panel = document.getElementById(t.getAttribute('aria-controls'));
        if (panel) panel.hidden = !on;
      });
    });
  })();
</script>

{% schema %}
{
  "name": "BW · Gaveguide",
  "tag": "section",
  "class": "bw-section",
  "max_blocks": 5,
  "settings": [
    { "type": "text", "id": "phases", "label": "Vis kun i faser", "info": "pre, early, live, sidste · tom = altid" },
    { "type": "text", "id": "eyebrow", "label": "Overlinje", "default": "Gaveguide" },
    { "type": "text", "id": "heading", "label": "Overskrift", "default": "Gaver under" }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Fane",
      "settings": [
        { "type": "text", "id": "label", "label": "Fanetekst", "default": "Under 300 kr." },
        { "type": "product_list", "id": "products", "label": "Produkter", "limit": 8 }
      ]
    }
  ],
  "presets": [
    {
      "name": "BW · Gaveguide",
      "blocks": [
        { "type": "tab", "settings": { "label": "Under 300 kr." } },
        { "type": "tab", "settings": { "label": "Under 500 kr." } },
        { "type": "tab", "settings": { "label": "Under 1000 kr." } }
      ]
    }
  ]
}
{% endschema %}
