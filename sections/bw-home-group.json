          }
        },
        "q_2": {
          "type": "item",
          "settings": {
            "question": "Hvordan får jeg rabatten?",
            "answer": "Rabatten trækkes automatisk i kurven – ingen kode nødvendig. Ved 3 for 2 er den billigste af 3 varer gratis. Ved 4 for 2 er de 2 billigste af 4 varer gratis."
          }
        },
        "q_3": {
          "type": "item",
          "settings": {
            "question": "Hvilke varer er med?",
            "answer": "Varer markeret med Limited edition, 3 for 2 eller 4 for 2. Du finder dem samlet i de tre Black Week-kollektioner."
          }
        },
        "q_4": {
          "type": "item",
          "settings": {
            "question": "Hvad er Limited Blackout?",
            "answer": "Helsorte udgaver af anti slip grips, fusion grips, Elite-bæltet og speedrope elite. De findes kun i Black Week."
          }
        },
        "q_5": {
          "type": "item",
          "settings": {
            "question": "Hvordan får jeg gaven?",
            "answer": "De første 100 ordrer i Black Week får en gratis Thermo stålflaske (1,06 L) med. Der er ingen beløbsgrænse."
          }
        }
