{%- comment -%}BLACK WEEK 2026 · Heading + product row (board 02 "Bestsellere lige nu" and "Køb julegaverne i Black Week"), ported 1:1 from the design.
Carousel (setting, 19.11, used at the bottom of product pages for 3 for 2 / 4 for 2): one scrolling row with snap,
2.3 cards visible on a phone and 4 on desktop, arrows on desktop (assets/bw.js [data-bw-car-prev/next]). On a product
page the product itself is left out. Quick add (setting) puts the quick add button on the cards.{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign G = 'max(clamp(20px,calc((100cqw - 767px)*1000),64px),calc((100cqw - 1312px)/2))'
  assign PY = 'clamp(48px,calc((100cqw - 767px)*1000),80px)'
  assign coll = s.collection
  if coll == blank and s.collection_handle != blank
    assign coll = collections[s.collection_handle]
  endif
  if s.products != blank and s.products.count > 0
    assign plist = s.products
  else
    assign plist = coll.products
  endif
-%}
<style>#shopify-section-{{ section.id }} a:hover { opacity: 1; } #shopify-section-{{ section.id }} .bw-card:hover .bw-card__img2 { opacity: 1 !important; }</style>
<div class="bw{% render 'bw-only', phases: s.phases %}" style="container-type:inline-size">
  <div style="background:#0a0a0a;color:#fff;padding:{{ PY }} {{ G }};display:grid;gap:24px{% if s.border_top %};border-top:1px solid #222{% endif %}">
    {%- if s.heading_size == 'sm' -%}
      <div style="margin-bottom:8px;display:flex;justify-content:space-between;align-items:flex-end;gap:16px;flex-wrap:wrap">
        <h2 style="margin:0;font-size:clamp(26px,3cqw,40px);font-weight:900;text-transform:uppercase;letter-spacing:-.005em;line-height:1;font-family:inherit;color:#fff">{{ s.heading_1 }}{% if s.heading_2 != blank %} {{ s.heading_2 }}{% endif %}</h2>
        <div style="display:flex;gap:16px;align-items:center">
          {%- if s.link_label != blank -%}<a href="{{ s.link_url | default: '#' }}" style="color:#fff;font-size:15px;font-weight:700;text-decoration:underline;text-underline-offset:4px">{{ s.link_label }}</a>{%- endif -%}
          {%- if s.carousel -%}
            <span class="bw-car__arrows">
              <button type="button" class="bw-car__btn" data-bw-car-prev aria-label="‹"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"></polyline></svg></button>
              <button type="button" class="bw-car__btn" data-bw-car-next aria-label="›"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg></button>
            </span>
          {%- endif -%}
        </div>
      </div>
    {%- else -%}
      <div style="margin-bottom:8px;display:flex;justify-content:space-between;align-items:flex-end;gap:16px 32px;flex-wrap:wrap">
        <div style="display:grid;gap:12px;max-width:640px">
          {%- if s.eyebrow != blank -%}<div style="font-size:12px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:#9b9b9b">{{ s.eyebrow }}</div>{%- endif -%}
          <h2 style="margin:0;font-size:clamp(34px,4.6cqw,68px);font-weight:900;text-transform:uppercase;letter-spacing:-.01em;line-height:1;font-family:inherit;color:#fff">{{ s.heading_1 }}{% if s.heading_2 != blank %}<br>{{ s.heading_2 }}{% endif %}</h2>
          {%- if s.text != blank -%}<div style="font-size:clamp(15px,1.25cqw,18px);line-height:1.5;color:#e4e4e4">{{ s.text }}</div>{%- endif -%}
        </div>
        {%- if s.link_label != blank -%}<a href="{{ s.link_url | default: '#' }}" style="color:#fff;font-size:15px;font-weight:700;text-decoration:underline;text-underline-offset:4px">{{ s.link_label }}</a>{%- endif -%}
      </div>
    {%- endif -%}
    {%- assign shown = 0 -%}
    {%- if s.carousel -%}
    <div class="bw-car bw-noscrollbar" data-bw-car>
    {%- else -%}
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(max(160px,calc((100% - 48px)/4)),1fr));gap:16px">
    {%- endif -%}
      {%- for p in plist -%}
        {%- if shown >= s.limit -%}{%- break -%}{%- endif -%}
        {%- if p.available == false -%}{%- continue -%}{%- endif -%}
        {%- if product != blank and p.id == product.id -%}{%- continue -%}{%- endif -%}
        {%- render 'bw-product-card', product: p, quick_add: s.quick_add -%}
        {%- assign shown = shown | plus: 1 -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "BW · Produktrække",
  "tag": "section",
  "class": "bw-section",
  "settings": [
    { "type": "text", "id": "phases", "label": "Vis kun i faser", "info": "pre, early, live, sidste · tom = altid" },
    { "type": "select", "id": "heading_size", "label": "Layout", "options": [ { "value": "sm", "label": "Lille overskrift (Bestsellere)" }, { "value": "lg", "label": "Stor overskrift + tekst (Julegaver)" } ], "default": "lg" },
    { "type": "checkbox", "id": "border_top", "label": "Streg over", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Overlinje", "default": "Julegaver" },
    { "type": "text", "id": "heading_1", "label": "Overskrift linje 1", "default": "Køb julegaverne" },
    { "type": "text", "id": "heading_2", "label": "Overskrift linje 2", "default": "i Black Week." },
    { "type": "textarea", "id": "text", "label": "Tekst" },
    { "type": "text", "id": "link_label", "label": "Linktekst", "default": "Se alle" },
    { "type": "url", "id": "link_url", "label": "Link" },
    { "type": "product_list", "id": "products", "label": "Produkter", "limit": 12 },
    { "type": "collection", "id": "collection", "label": "…eller kollektion" },
    { "type": "text", "id": "collection_handle", "label": "…eller kollektions-handle" },
    { "type": "range", "id": "limit", "label": "Antal produkter", "min": 2, "max": 48, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "carousel", "label": "Karrusel (én række der scroller)", "default": false },
    { "type": "checkbox", "id": "quick_add", "label": "Quick add på kortene", "default": false }
  ],
  "presets": [ { "name": "BW · Produktrække" } ]
}
{% endschema %}
