{%- comment -%}BLACK WEEK 2026 · Athlete image with text (board 02, replaces the live image-with-text overlay #1), ported 1:1 from the design.{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign G = 'max(clamp(20px,calc((100cqw - 767px)*1000),64px),calc((100cqw - 1312px)/2))'
-%}
<style>#shopify-section-{{ section.id }} a:hover { opacity: 1; }</style>
<div class="bw{% render 'bw-only', phases: s.phases %}" style="container-type:inline-size">
  <div style="position:relative;min-height:clamp(560px,46cqw,680px);background:#0a0a0a;overflow:hidden;color:#fff;display:flex;align-items:flex-end">
    {%- if s.image != blank -%}{{ s.image | image_url: width: 2400 | image_tag: loading: 'lazy', sizes: '100vw', widths: '750,1100,1500,2000,2400', alt: s.image.alt, style: 'position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:50% 22%' }}{%- endif -%}
    <div style="position:absolute;inset:0;background:linear-gradient(180deg,rgba(10,10,10,.15) 0%,rgba(10,10,10,.35) 45%,rgba(10,10,10,.88) 100%)"></div>
    <div style="position:relative;padding:clamp(32px,4.4cqw,72px) {{ G }};display:grid;gap:16px;max-width:680px">
      <div style="font-size:12px;font-weight:800;letter-spacing:.1em;text-transform:uppercase">{{ s.eyebrow }}</div>
      <h2 style="margin:0;font-size:clamp(34px,4.6cqw,68px);font-weight:900;text-transform:uppercase;letter-spacing:-.01em;line-height:1;font-family:inherit;color:#fff">{{ s.heading_1 }}<br>{{ s.heading_2 }}</h2>
      <div style="font-size:clamp(15px,1.25cqw,18px);line-height:1.5;color:#e4e4e4;max-width:500px">{{ s.text }}</div>
      {%- if s.button_label != blank -%}<a href="{{ s.button_url | default: '#' }}" style="display:inline-flex;align-items:center;justify-content:center;height:48px;padding:0 28px;border-radius:999px;font-size:15px;font-weight:700;text-decoration:none;background:#fff;color:#111;justify-self:start">{{ s.button_label }}</a>{%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "BW · Billede med tekst",
  "tag": "section",
  "class": "bw-section",
  "settings": [
    { "type": "text", "id": "phases", "label": "Vis kun i faser", "info": "pre, early, live, sidste · tom = altid" },
    { "type": "image_picker", "id": "image", "label": "Billede" },
    { "type": "text", "id": "eyebrow", "label": "Overlinje", "default": "Dansk udviklet · Lavet til at holde" },
    { "type": "text", "id": "heading_1", "label": "Overskrift linje 1", "default": "Til hård træning." },
    { "type": "text", "id": "heading_2", "label": "Overskrift linje 2", "default": "Hele året." },
    { "type": "textarea", "id": "text", "label": "Tekst", "default": "Grips, bælter og træningstøj udviklet sammen med vores ambassadører og interne atleter. Testet i boksen, WOD efter WOD." },
    { "type": "text", "id": "button_label", "label": "Knap", "default": "Se single offers" },
    { "type": "url", "id": "button_url", "label": "Knaplink" }
  ],
  "presets": [ { "name": "BW · Billede med tekst" } ]
}
{% endschema %}
