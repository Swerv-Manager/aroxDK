{%- comment -%}BLACK WEEK 2026 · Rødt tilbudsbånd, ported 1:1 from the design. Items separated by "|".{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign G = 'max(clamp(20px,calc((100cqw - 767px)*1000),64px),calc((100cqw - 1312px)/2))'
  assign items = s.items | split: '|'
-%}
<div class="bw{% render 'bw-only', phases: s.phases %}" style="container-type:inline-size">
  <div style="background:#c8232c;color:#fff;padding:14px {{ G }};display:flex;flex-wrap:wrap;gap:6px 22px;align-items:center;justify-content:center;font-size:13px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;text-align:center">
    {%- for it in items -%}{%- unless forloop.first -%}<span>∙</span>{%- endunless -%}<span>{{ it | strip }}</span>{%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "BW · Tilbudsbånd",
  "tag": "section",
  "class": "bw-section",
  "settings": [
    { "type": "text", "id": "phases", "label": "Vis kun i faser", "info": "pre, early, live, sidste · tom = altid" },
    { "type": "text", "id": "items", "label": "Tekster", "info": "Adskil med |", "default": "Limited edition|3 for 2|4 for 2|Rabatten trækkes automatisk i kurven" }
  ],
  "presets": [ { "name": "BW · Tilbudsbånd" } ]
}
{% endschema %}
