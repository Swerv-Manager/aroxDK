{%- comment -%}BLACK WEEK 2026 · Rødt tilbudsbånd (02 Forside){%- endcomment -%}
<div class="bw{% render 'bw-only', phases: section.settings.phases %}">
  <div class="bw-band">
    {%- for block in section.blocks -%}
      {%- unless forloop.first -%}<span aria-hidden="true">∙</span>{%- endunless -%}
      <span {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "BW · Tilbudsbånd",
  "tag": "section",
  "class": "bw-section",
  "settings": [
    { "type": "text", "id": "phases", "label": "Vis kun i faser", "info": "pre, early, live, sidste · tom = altid" }
  ],
  "blocks": [
    { "type": "item", "name": "Tekst", "settings": [ { "type": "text", "id": "text", "label": "Tekst", "default": "3 for 2" } ] }
  ],
  "presets": [
    {
      "name": "BW · Tilbudsbånd",
      "blocks": [
        { "type": "item", "settings": { "text": "Limited edition" } },
        { "type": "item", "settings": { "text": "3 for 2" } },
        { "type": "item", "settings": { "text": "4 for 2" } },
        { "type": "item", "settings": { "text": "Rabatten trækkes automatisk i kurven" } }
      ]
    }
  ]
}
{% endschema %}
