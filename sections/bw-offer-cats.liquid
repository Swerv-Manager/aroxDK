{%- comment -%}BLACK WEEK 2026 · "Tre tilbud. Én kurv." – the three offer categories, ported 1:1 from the design (boards 02 + 03).{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign G = 'max(clamp(20px,calc((100cqw - 767px)*1000),64px),calc((100cqw - 1312px)/2))'
  assign PY = 'clamp(48px,calc((100cqw - 767px)*1000),80px)'
-%}
<style>
  #shopify-section-{{ section.id }} .bwcat { border-color: #161616; }
  #shopify-section-{{ section.id }} .bwcat:hover { border-color: #fff; opacity: 1; }
</style>
<div class="bw{% render 'bw-only', phases: s.phases %}" style="container-type:inline-size">
  <div id="tilbud" style="background:#0a0a0a;padding:{{ PY }} {{ G }};display:grid;gap:24px">
    <div style="margin-bottom:8px;display:grid;gap:12px">
      <div style="font-size:12px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:#c9c9c9">{{ s.eyebrow }}</div>
      <h2 style="margin:0;font-size:clamp(34px,4.6cqw,68px);font-weight:900;text-transform:uppercase;letter-spacing:-.01em;line-height:1;font-family:inherit;color:#fff">{{ s.heading_1 }}<br>{{ s.heading_2 }}</h2>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(max(260px,calc((100% - 32px)/3)),1fr));gap:16px">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <a href="{{ b.url | default: '#' }}" class="bwcat" {{ block.shopify_attributes }} style="background:#161616;border-radius:8px;overflow:hidden;display:grid;align-content:start;color:#fff;text-decoration:none;border-width:1px;border-style:solid;transition:border-color .15s ease-out">
          <div style="position:relative;aspect-ratio:4/3;background:#0a0a0a;overflow:hidden">
            {%- if b.image != blank -%}{{ b.image | image_url: width: 1000 | image_tag: loading: 'lazy', sizes: '(min-width: 768px) 33vw, 100vw', widths: '400,600,800,1000', alt: '', style: 'position:absolute;inset:0;width:100%;height:100%;object-fit:cover' }}{%- endif -%}
            <div style="position:absolute;inset:0;background:rgba(10,10,10,{{ b.overlay | divided_by: 100.0 }})"></div>
            <span style="position:absolute;top:14px;left:14px;background:#c8232c;color:#fff;font-size:11px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;padding:5px 9px;border-radius:4px">{{ b.badge }}</span>
          </div>
          <div style="padding:20px;display:grid;gap:10px">
            <div style="font-size:22px;font-weight:900;text-transform:uppercase;letter-spacing:-.005em;line-height:1">{{ b.heading }}</div>
            <div style="font-size:15px;line-height:1.5;color:#c9c9c9">{{ b.text }}</div>
            <span style="justify-self:start;margin-top:4px;display:inline-flex;gap:8px;align-items:center;color:#fff;font-size:15px;font-weight:700;text-decoration:underline;text-underline-offset:4px">{{ b.cta }}<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="flex:none"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="13 6 19 12 13 18"></polyline></svg></span>
          </div>
        </a>
      {%- endfor -%}
    </div>
    {%- if s.note != blank -%}<div style="font-size:16px;font-weight:600;color:#fff">{{ s.note }}</div>{%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "BW · Tilbudskategorier",
  "tag": "section",
  "class": "bw-section",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "phases", "label": "Vis kun i faser", "info": "pre, early, live, sidste · tom = altid" },
    { "type": "text", "id": "eyebrow", "label": "Overlinje", "default": "Sådan virker Black Week" },
    { "type": "text", "id": "heading_1", "label": "Overskrift linje 1", "default": "Tre tilbud." },
    { "type": "text", "id": "heading_2", "label": "Overskrift linje 2", "default": "Én kurv." },
    { "type": "text", "id": "note", "label": "Tekst under kortene", "default": "Rabatten trækkes automatisk i kurven – ingen kode nødvendig." }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Tilbud",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Billede" },
        { "type": "range", "id": "overlay", "label": "Mørk overlay", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 30 },
        { "type": "text", "id": "badge", "label": "Badge", "default": "3 for 2" },
        { "type": "text", "id": "heading", "label": "Overskrift", "default": "TAG 3. BETAL FOR 2." },
        { "type": "textarea", "id": "text", "label": "Tekst", "default": "Læg 3 varer fra 3 for 2 i kurven, og betal for de 2 dyreste. Den billigste er gratis." },
        { "type": "text", "id": "cta", "label": "Linktekst", "default": "Shop 3 for 2" },
        { "type": "url", "id": "url", "label": "Link" }
      ]
    }
  ],
  "presets": [ { "name": "BW · Tilbudskategorier" } ]
}
{% endschema %}
