{%- comment -%}BLACK WEEK 2026 · "Tre tilbud. Én kurv." tilbudskategorier (02 Forside, 03 Landingsside){%- endcomment -%}
{%- assign s = section.settings -%}
<div class="bw{% render 'bw-only', phases: s.phases %}">
  <div class="bw-sec" id="tilbud">
    <div class="bw-head">
      {%- if s.eyebrow != blank -%}<div class="bw-eyebrow bw-eyebrow--light">{{ s.eyebrow }}</div>{%- endif -%}
      <h2 class="bw-h2">{{ s.heading_1 }}{% if s.heading_2 != blank %}<br>{{ s.heading_2 }}{% endif %}</h2>
    </div>
    <div class="bw-grid bw-grid-3">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <a href="{{ b.link | default: '#' }}" class="bw-cat" {{ block.shopify_attributes }}>
          <div class="bw-cat__media">
            {%- if b.image != blank -%}
              {{ b.image | image_url: width: 900 | image_tag: class: 'bw-media__img', loading: 'lazy', sizes: '(min-width: 768px) 33vw, 100vw', widths: '400,600,900', alt: '' }}
            {%- endif -%}
            <div class="bw-media__ov" style="--ov: {{ b.overlay | divided_by: 100.0 }}"></div>
            {%- if b.badge != blank -%}<span class="bw-badge bw-badge--abs">{{ b.badge }}</span>{%- endif -%}
          </div>
          <div class="bw-cat__body">
            <div class="bw-h3">{{ b.heading }}</div>
            {%- if b.text != blank -%}<div class="bw-body">{{ b.text }}</div>{%- endif -%}
            {%- if b.cta != blank -%}<span class="bw-link">{{ b.cta }}{% render 'bw-icon', name: 'arrow' %}</span>{%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    </div>
    {%- if s.footnote != blank -%}<div class="bw-strong">{{ s.footnote }}</div>{%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "BW · Tilbudskategorier",
  "tag": "section",
  "class": "bw-section",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "phases", "label": "Vis kun i faser", "info": "pre, early, live, sidste · tom = altid" },
    { "type": "text", "id": "eyebrow", "label": "Overlinje", "default": "Sådan virker Black Week" },
    { "type": "text", "id": "heading_1", "label": "Overskrift linje 1", "default": "Tre tilbud." },
    { "type": "text", "id": "heading_2", "label": "Overskrift linje 2", "default": "Én kurv." },
    { "type": "text", "id": "footnote", "label": "Tekst under kortene", "default": "Rabatten trækkes automatisk i kurven – ingen kode nødvendig." }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Tilbud",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Billede" },
        { "type": "range", "id": "overlay", "label": "Mørk overlay", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 30 },
        { "type": "text", "id": "badge", "label": "Badge", "default": "3 for 2" },
        { "type": "text", "id": "heading", "label": "Overskrift", "default": "TAG 3. BETAL FOR 2." },
        { "type": "textarea", "id": "text", "label": "Tekst", "default": "Læg 3 varer fra 3 for 2 i kurven, og betal for de 2 dyreste. Den billigste er gratis." },
        { "type": "text", "id": "cta", "label": "Linktekst", "default": "Shop 3 for 2" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "BW · Tilbudskategorier",
      "blocks": [
        { "type": "category", "settings": { "badge": "Single offers", "heading": "LIMITED BLACKOUT.", "text": "Limited blackout og udvalgte favoritter til fast Black Week-pris. Limited findes kun i Black Week.", "cta": "Se single offers", "overlay": 20 } },
        { "type": "category", "settings": { "badge": "3 for 2", "heading": "TAG 3. BETAL FOR 2.", "text": "Læg 3 varer fra 3 for 2 i kurven, og betal for de 2 dyreste. Den billigste er gratis.", "cta": "Shop 3 for 2", "overlay": 30 } },
        { "type": "category", "settings": { "badge": "4 for 2", "heading": "TAG 4. BETAL FOR 2.", "text": "Læg 4 varer fra 4 for 2 i kurven, og betal for de 2 dyreste. De 2 billigste er gratis.", "cta": "Shop 4 for 2", "overlay": 50 } }
      ]
    }
  ]
}
{% endschema %}
